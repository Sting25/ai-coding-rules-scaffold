#!/usr/bin/env bash
# .githooks/lib/agent-precheck — agent PreToolUse hook (scaffold "layer three":
# block bad content the moment an agent writes it, before commit time).
#
# Wired as a Claude Code PreToolUse hook (.claude/settings.json, matcher
# Write|Edit|MultiEdit|Bash). The payload is JSON on stdin: the command lives
# under .tool_input.command and the tool name under .tool_name. Exits 2 to
# block; Claude feeds stderr back to the model. Claude denies credential-file
# reads natively via its own permissions.deny, so this script is never invoked
# for a Claude Read and carries no read-path branch.
#
# Write/Edit/Bash content is scanned against the SAME patterns the commit-time
# scanner uses. One source of truth across agent -> commit -> CI:
#   - .forbidden-patterns/secrets.txt  (all tool calls; case-insensitive by
#     default, case-sensitive for rules carrying the `(?-i)` marker, exactly
#     as check-secrets does) — a credential the agent tries to hardcode is
#     refused at write time.
#   - .forbidden-patterns/shell.txt    (Bash tool calls only, case-sensitive to
#     match the commit-time semantics) — curl|bash, rm -rf /, chmod 777 etc. are
#     refused before the agent runs them. RECOMMENDATIONS.md calls this the
#     single highest-ROI agent hook.
#
# Requires `jq`. If jq is missing, or a pattern file is absent, it fails OPEN
# (allow) — an agent helper must never brick the session; the pre-commit hook
# and CI (and, for Claude reads, permissions.deny) are the fail-CLOSED
# backstops.
#
# Documented limits (accepted on purpose):
#   - A quoted flag or quoted force form is allowed, so commit messages and
#     greps that merely NAME a flag stay usable.
#   - A quoted-delimiter heredoc whose body continues a forbidden command across
#     a backslash-newline is refused, although bash does not join continuations
#     inside it. A minor false positive.
# Known gaps (this is a text scan, not a shell parser, so it cannot see these):
#   - a flag assembled from two variables (variable splitting)
#   - ANSI-C quoting ($'...')
#   - base64 piped into sh
#   - $(printf ...) command substitution
#   - an upper-case GIT binary name
# The commit-time scan and CI are the fail-closed backstops for all of them.
#
# Exit: 0 = allow (prints nothing), 2 = block (stderr shown to the model).

set -euo pipefail

command -v jq >/dev/null 2>&1 || exit 0

payload=$(cat)

# Project root: Claude Code exports CLAUDE_PROJECT_DIR. Fall back to the cwd the
# event reports, then to ".".
ROOT=${CLAUDE_PROJECT_DIR:-}
[ -n "$ROOT" ] || ROOT=$(jq -r '.cwd // "."' <<<"$payload" 2>/dev/null || echo .)

tool=$(jq -r '.tool_name // empty' <<<"$payload" 2>/dev/null || true)

# Record a refusal in the durable log (issue #218) and print the class trailer
# (issue #259). The trailer is printed first, outside the quiet subshell below,
# so it ends the BLOCKED message; the logging itself is silent and every failure
# in it is swallowed, so the `exit 2` that follows each call is never lost.
# bash 5.3: cd "" is fatal; no dirname(1) needed (see scaffold-doctor.sh)
case $0 in */*) _sd=${0%/*}; [ -n "$_sd" ] || _sd=/ ;; *) _sd=. ;; esac
# CDPATH would make cd echo the directory; see pre-commit
unset CDPATH
SELF_DIR="$(cd "$_sd" && pwd)"
rl_log() {
  [ -x "$SELF_DIR/refusal-log" ] || return 0
  "$SELF_DIR/refusal-log" --say a || true
  local f cmd sid
  f=$(jq -r '.tool_input.file_path // empty' <<<"$payload" 2>/dev/null || true)
  cmd=$(jq -r '.tool_input.command // empty' <<<"$payload" 2>/dev/null || true)
  sid=${CLAUDE_SESSION_ID:-}
  [ -n "$sid" ] || sid=$(jq -r '.session_id // empty' <<<"$payload" 2>/dev/null || true)
  (
    cd "$ROOT" 2>/dev/null || exit 0
    export CLAUDE_SESSION_ID="$sid"
    if [ "$tool" = Bash ]; then
      printf '%s' "$cmd" | "$SELF_DIR/refusal-log" agent-precheck "$1" "$f" 2 --stdin-hash --say a || true
    else
      "$SELF_DIR/refusal-log" agent-precheck "$1" "$f" 2 --say a || true
    fi
  ) >/dev/null 2>&1 || true
}

# Scan only the text the tool would WRITE or RUN: Write.content, Edit.new_string,
# MultiEdit edits[].new_string, Bash.command. Walking every string in the
# payload also scanned old_string, which is text the edit REMOVES: an Edit that
# replaces a hardcoded secret with an env-var read carries the secret in
# old_string and was blocked for fixing the very problem this hook exists to
# prevent. file_path and the other metadata are not content either. The `?` and
# the string filter keep an absent or non-string field from aborting the
# extraction.
content=$(jq -r '[.tool_input | (.content?, .new_string?, (.edits[]? | .new_string?), .command?) | strings] | join("\n")' <<<"$payload" 2>/dev/null || true)
[ -n "$content" ] || exit 0

# Drop pathologically long lines (a minified bundle pasted into a Write) so the
# combined ERE can't be made to hang — same guard as check-secrets. But an
# over-cap line must FAIL CLOSED here (block, exit 2), not ride through as
# "allow": a secret or a `curl|bash` padded past MAX_LINE_LENGTH would otherwise
# be silently permitted at write time while its short form blocks. This is the
# one place agent-precheck blocks rather than failing open — an *unscannable*
# line is not the same as a *missing scanner* (jq/config), and consistency with
# the short-input block wins. awk exit 9 signals "a line was dropped".
MAX_LINE_LENGTH=${MAX_LINE_LENGTH:-50000}
cap_rc=0
content=$(printf '%s\n' "$content" | awk -v n="$MAX_LINE_LENGTH" 'length > n { d=1; next } { print } END { exit (d ? 9 : 0) }') || cap_rc=$?
if [ "$cap_rc" -eq 9 ]; then
  {
    echo "BLOCKED by agent-precheck: a line over $MAX_LINE_LENGTH chars is too long"
    echo "to scan for secret/shell patterns — split the content (or raise"
    echo "MAX_LINE_LENGTH, accepting the ReDoS cost) before this write/command runs."
  } >&2
  rl_log line-too-long
  exit 2
fi
[ -n "$content" ] || exit 0

# scan_against <patternfile> <i|""> <advice line>
#   Loads + validates patterns (mirror of check-secrets' parsing), builds the
#   combined ERE, scans $content. On a match (minus scaffold-allow lines) it
#   prints a BLOCKED message naming the file and EXITS 2. The case flag is `i`
#   for secrets (case-insensitive) and "" for shell (case-sensitive — matches
#   the commit-time check-patterns semantics). A missing file or an unparseable
#   pattern set returns cleanly (fail-OPEN: this is an advisory pre-check, not
#   the security boundary — commit + CI are the fail-closed backstops).
# Join one bucket of patterns into a single alternation and scan $SCAN_TEXT with
# it. $1 is the grep case flag ("i" or ""); the rest are the patterns. Prints
# matching lines, or nothing when the bucket is empty or its combined ERE is
# invalid (the same fail-open-on-invalid posture the single-bucket scan had).
scan_bucket() {
  local iflag=$1; shift
  [ $# -eq 0 ] && return 0
  local combined="" p c_err
  for p in "$@"; do
    if [ -z "$combined" ]; then combined="(${p})"; else combined="${combined}|(${p})"; fi
  done
  c_err=$(printf '' | grep -E -- "$combined" 2>&1 1>/dev/null || true)
  [ -z "$c_err" ] || return 0
  # A comment-anchored `scaffold-allow` exempts a line, exactly like the scanners.
  # The exemption is for file content a person sanctioned. A Bash command is text
  # the agent itself authors and is about to run, so there it never exempts: an
  # appended marker would otherwise defeat every shell and secret rule.
  if [ "$tool" = Bash ]; then
    printf '%s\n' "$SCAN_TEXT" | grep -an"${iflag}"E -- "$combined" || true
  else
    printf '%s\n' "$SCAN_TEXT" | grep -an"${iflag}"E -- "$combined" \
      | grep -ivE '(^[0-9]+:|[[:space:]])(#|//|/\*|<!--)[[:space:]]*scaffold-allow' || true
  fi
}

# Scan $content, then (Bash only) a normalised copy with line continuations
# joined, backslashes before a word character or hyphen removed and whitespace
# runs collapsed, so an escaped or continued flag cannot slip past a pattern that
# expects it after a space. Quotes are kept: the rules exclude quoted text on
# purpose, and the commit-time scan must agree. Sets HIT, and NORM_HIT=1 when
# only the copy matched.
scan_both() {
  local iflag=$1; shift
  NORM_HIT=0
  SCAN_TEXT=$content
  HIT=$(scan_bucket "$iflag" "$@")
  if [ -z "$HIT" ] && [ "$tool" = Bash ]; then
    # Join line continuations, drop only a backslash before a word character or
    # hyphen (so `\|`, `\;`, `\"` and `\ ` stay as they are), collapse blanks.
    SCAN_TEXT=${content//\\$'\n'/}
    SCAN_TEXT=$(printf '%s' "$SCAN_TEXT" | sed -E 's/\\([[:alnum:]_-])/\1/g' | tr -s '[:blank:]' ' ')
    HIT=$(scan_bucket "$iflag" "$@")
    [ -z "$HIT" ] || NORM_HIT=1
  fi
}

scan_against() {
  local pfile=$1 iflag=$2 advice=$3
  # Only secrets.txt and shell.txt reach this function, and neither carries the
  # optional third `exclude=<globs>` field that check-patterns reads (it is for
  # per-language rules such as backend.txt's print() rule, which this hook does
  # not scan). The pattern is cut at the first TAB below, so a third field on a
  # line here would be ignored, not parsed into the regex. Path excludes are
  # deliberately NOT applied: a Bash payload has no file path, and the commit
  # scan applies them to the files that matter.
  [ -f "$pfile" ] || return 0
  # Two buckets: rules matched with this file's DEFAULT case flag, and rules
  # carrying the `(?-i)` marker, which are matched case-SENSITIVELY regardless.
  #
  # The marker MUST be stripped here. It is a scaffold convention, not ERE
  # syntax (POSIX ERE has no inline flags), and GNU grep rejects `(?-i)…` as an
  # invalid ERE — which the validity check below would silently treat as a bad
  # pattern and DROP, disarming every marked rule and failing OPEN. (BSD grep
  # is laxer, so this divergence hides on macOS and only shows up on Linux.)
  # See check-secrets for why token-shaped rules need case sensitivity.
  local pats_def=() pats_cs=() line pattern p_err is_cs hit
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    case "$line" in *$'\t'*) ;; *) continue ;; esac
    pattern=${line%%$'\t'*}
    is_cs=0
    case "$pattern" in
      '(?-i)'*) is_cs=1; pattern=${pattern#'(?-i)'} ;;
    esac
    [ -z "$pattern" ] && continue
    # `printf '' | grep -E p` writes to stderr only when p is invalid — drop it.
    p_err=$(printf '' | grep -E -- "$pattern" 2>&1 1>/dev/null || true)
    [ -z "$p_err" ] || continue
    if [ "$is_cs" -eq 1 ]; then pats_cs+=("$pattern"); else pats_def+=("$pattern"); fi
  done <"$pfile"
  [ $((${#pats_def[@]} + ${#pats_cs[@]})) -eq 0 ] && return 0

  # Guarded by an explicit count so an empty array is never expanded under
  # `set -u` (bash 3.2 on macOS errors on "${empty[@]}").
  hit=""
  if [ ${#pats_def[@]} -gt 0 ]; then scan_both "$iflag" "${pats_def[@]}"; hit=$HIT; fi
  if [ -z "$hit" ] && [ ${#pats_cs[@]} -gt 0 ]; then
    scan_both "" "${pats_cs[@]}"; hit=$HIT
  fi
  [ -n "$hit" ] || return 0
  # A normalised-copy match shows the matching lines of the copy, so say so.
  [ "$NORM_HIT" -eq 0 ] || hit="(backslashes and repeated whitespace removed)"$'\n'"$hit"

  {
    echo "BLOCKED by agent-precheck: $advice"
    echo "(${pfile#"$ROOT"/}). Stop and report this block to the user with the rule that matched."
    echo "A suppression needs a recorded reason and the user's go-ahead (AGENTS.md > \"Fix the file, not the check\"); do not work around the block."
    if [ "$tool" = Bash ]; then
      echo "A scaffold-allow comment does not exempt a Bash command: the marker is for file content a person sanctioned, not for text you are about to run. Use the Write or Edit tool for file content."
    fi
    echo "Matched:"
    # `|| true`: on a many-line $hit, `head -3` closes the pipe early and printf
    # takes SIGPIPE (exit 141). Under `set -euo pipefail` that would abort the
    # script BEFORE the `exit 2` below — and the agent runtime treats only exit 2
    # as "block", so a non-2 exit silently ALLOWS the matched action (fail-open).
    printf '%s\n' "$hit" | head -3 || true
  } >&2
  local stem=${pfile##*/}
  rl_log "${stem%.txt}"
  exit 2
}

# Secrets: every tool call, case-insensitive.
scan_against "$ROOT/.forbidden-patterns/secrets.txt" i \
  "this content matches a secret pattern — don't hardcode credentials; read them from an env var or secret manager"

# Shell: command executions only, case-sensitive (commit-time semantics).
# Claude reports tool_name "Bash" for a shell command.
if [ "$tool" = "Bash" ]; then
  scan_against "$ROOT/.forbidden-patterns/shell.txt" "" \
    "this command matches a dangerous shell pattern (e.g. curl|bash, rm -rf /, chmod 777) — don't run it"
fi

exit 0
