#!/usr/bin/env bash
# .githooks/lib/check-hygiene — repo-hygiene guards that aren't secret- or
# pattern-specific. Reads NUL-separated file paths on stdin (produced by
# `git ... -z`). Three checks:
#
#   1. Merge-conflict markers. A committed `<<<<<<<` / `|||||||` / `>>>>>>>`
#      marker means an unresolved conflict shipped — it breaks the build and is
#      pure accident. Scans the STAGED/INDEXED BLOB via `git show ":0:<path>"`
#      (like check-secrets/check-patterns), so symlinks, NUL bytes, and
#      post-stage edits can't hide the marker. The `=======` middle marker is
#      deliberately NOT matched on its own — a row of 7+ `=` is a common reST /
#      Markdown heading underline, and every real conflict already carries the
#      unambiguous `<<<<<<<` and `>>>>>>>` markers.
#
#   2. Case-only filename collisions. Two tracked paths that differ only in case
#      (`README.md` vs `Readme.md`) coexist on Linux but collide on a
#      case-insensitive filesystem (macOS default, Windows), corrupting the
#      checkout. In the hook the list is the staged files; in CI it's every
#      tracked file, which catches a collision against an already-committed file.
#
#   3. Hidden Unicode (bidi / zero-width / tag / variation selector). Invisible
#      control characters hidden in a text file silently change how it reads:
#      bidi overrides (CVE-2021-42574 "Trojan Source") reorder code; zero-width,
#      tag-block and variation-selector characters smuggle instructions into
#      agent-read files (AGENTS.md, coding-rules.md, .forbidden-patterns/*),
#      the Feb-2025 "Rules File Backdoor". The variation selectors supplement
#      (U+E0100–U+E01EF) is the byte-per-codepoint channel that carries a whole
#      sentence invisibly, so it is matched alongside the tag block.
#      Matches the UTF-8 byte sequences under LC_ALL=C (portable to
#      BSD grep / bash 3.2). Binary blobs (a NUL in the first 8 KB) are skipped —
#      images legitimately contain these byte sequences and aren't read as
#      instructions. A legitimate leading BOM is allowed; a mid-file one is not.
#
# Two things are NOT refused by the hidden-Unicode rule, because both are
# routine in legitimate text:
#   - U+200D ZERO WIDTH JOINER between two emoji codepoints. It is the glue in
#     every multi-person, profession and skin-tone emoji (family, woman
#     technologist, rainbow flag), so a README or UI string using one is fine.
#     A ZWJ anywhere else (between letters, inside an identifier, at a line
#     edge, doubled) is still refused: that is the Trojan-source shape.
#   - Locale files. Paths matching `locales/*`, `locale/*`, `i18n/*`, their
#     `*/` nested forms, `*.po` and `*.pot` skip the hidden-Unicode scan
#     entirely (ZWNJ is mandatory in Persian and some Indic scripts, LRM/RLM are
#     routine in RTL strings, soft hyphens in German), because JSON/YAML/PO
#     cannot carry a per-line `scaffold-allow`. Add more paths with
#     `exclude = ["src/strings.json"]` in `[rules.hidden-unicode]` in
#     .scaffold.toml; they ADD to those defaults, are `case` globs on the
#     repo-relative path (`*` spans `/`), and apply to THIS rule only: the
#     conflict-marker and case-collision checks still scan the same paths.
#     Each skipped file is announced once in the output.
#
# A `scaffold-allow` marker (after a comment leader) exempts a conflict-marker or
# hidden-Unicode line, for the rare doc that shows one on purpose.
#
# Per-project overrides (lib/scaffold-config, .scaffold.toml): the rule ids
# `conflict-marker`, `case-collision`, and `hidden-unicode` can each be disabled
# or downgraded to a non-failing warning. Absent/unparseable config → all fully
# enforced (safe).
#
# Output: human-readable on tty; ::error file=...:: when --ci is passed.
# Exit:   0 if all OK, 1 if any violation.

set -euo pipefail

# CDPATH must not reach the `$(cd ... && pwd)` below. When cd resolves its
# argument through CDPATH it PRINTS the directory it landed in, and that line
# is captured ahead of pwd's, so the variable ends up holding two lines and
# every path built from it is wrong. Hooks are invoked by relative path, so a
# developer with CDPATH='.' in their shell profile hit this on every commit.
# Unset rather than `CDPATH= cd` so any later cd in this file is safe too.
unset CDPATH

# Plain (NOT exported) assignment: bash's OWN length/substring/pattern-match
# operations on $content below (${#content}, ${content:0:3}, ${content#...})
# are locale-aware for MULTIBYTE character boundaries, not just the explicit
# `LC_ALL=C` already on every subprocess call in this file (git/tr/awk/grep).
# Under the ambient UTF-8 locale this scaffold assumes, those bash-internal
# ops silently count BOM/bidi/zero-width bytes as single characters instead
# of the "each byte is one character" contract the header above documents,
# which desyncs a byte-index substring check from the actual bytes, and (far
# worse, measured) makes a large multibyte-locale string catastrophically
# slow in bash 3.2's pattern matcher: ~77s for an 820 KB file on the
# `${content#$'\xef\xbb\xbf'}` BOM strip below, versus ~0.002s once this line
# forces byte-wise semantics. Left un-exported so it never reaches a child
# process (they already carry their own explicit LC_ALL=C where it matters).
LC_ALL=C

CI_MODE=0
[ "${1:-}" = "--ci" ] && CI_MODE=1

# Escape a value for a GitHub workflow command (see check-secrets).
ghesc() {
  local s=$2
  s=${s//'%'/%25}; s=${s//$'\r'/%0D}; s=${s//$'\n'/%0A}
  if [ "$1" = prop ]; then s=${s//:/%3A}; s=${s//,/%2C}; fi
  printf '%s' "$s"
}

# Per-project overrides (.scaffold.toml via the sibling scaffold-config helper).
# Fails open to empty output when the helper is missing (older install), so the
# caller treats the rule as fully enforced.
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_BIN="$SELF_DIR/scaffold-config"
cfg() { [ -x "$CONFIG_BIN" ] || return 0; "$CONFIG_BIN" "$@" 2>/dev/null || true; }

# path_excluded <file> <default-globs> <rule-id>: succeeds when <file> matches a
# glob in the comma-separated shipped default list or in the rule's `exclude`
# key in .scaffold.toml. Same helper and semantics as check-patterns (each check
# script is standalone, so it is repeated rather than shared): globs are `case`
# patterns, `*` also matches `/`, and the list is walked line by line so a glob
# is only ever compared with the path, never expanded against the working tree.
path_excluded() {
  local file=$1 defaults=$2 id=$3 g nl=$'\n'
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    # shellcheck disable=SC2254  # intentional glob match of $file against $g
    case "$file" in $g) return 0 ;; esac
  done <<EOF_EXCL
${defaults//,/$nl}
$(cfg rule-excludes "$id")
EOF_EXCL
  return 1
}

# Emit a finding at the resolved severity. `warn` reports without failing the
# build; `error` sets FAILED. (Callers skip the check entirely when `disabled`.)
emit() {
  local state=$1 file=$2 message=$3
  if [ "$state" = warn ]; then
    if [ "$CI_MODE" -eq 1 ]; then
      echo "::warning file=$(ghesc prop "$file")::$(ghesc data "$message")"
    else
      echo "! $file: $message (warn — .scaffold.toml override)"
    fi
  else
    if [ "$CI_MODE" -eq 1 ]; then
      echo "::error file=$(ghesc prop "$file")::$(ghesc data "$message")"
    else
      echo "✗ $file: $message"
    fi
    FAILED=1
  fi
}

# Same per-line length cap as check-secrets/check-patterns — keep a pathological
# minified blob from being slurped whole, even though the marker regex is
# anchored and linear.
MAX_LINE_LENGTH=${MAX_LINE_LENGTH:-50000}
case "$MAX_LINE_LENGTH" in
  ''|*[!0-9]*) echo "error: MAX_LINE_LENGTH must be a positive integer, got: $MAX_LINE_LENGTH" >&2; exit 2 ;;
esac
[ "$MAX_LINE_LENGTH" -gt 0 ] || { echo "error: MAX_LINE_LENGTH must be > 0" >&2; exit 2; }

FILES=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] && FILES+=("$f")
done

[ ${#FILES[@]} -eq 0 ] && exit 0

FAILED=0

# --- 1. merge-conflict markers ---------------------------------------------
CONFLICT_STATE=$(cfg rule-state conflict-marker); [ -n "$CONFLICT_STATE" ] || CONFLICT_STATE=error
if [ "$CONFLICT_STATE" != disabled ]; then
  CONFLICT_RE='^(<{7}|>{7}|\|{7})( |$)'
  for file in "${FILES[@]}"; do
    # FAIL CLOSED on an over-cap line (check-secrets parity). The line is dropped
    # before the marker scan — that is the ReDoS guard — but an unscannable line
    # must not pass silently: awk exit 9 ("a line was dropped") triggers a finding
    # at the rule's severity, while the in-cap lines below are still scanned.
    cap_rc=0
    content=$(git show ":0:$file" 2>/dev/null | LC_ALL=C tr -d '\000' | awk -v n="$MAX_LINE_LENGTH" 'length > n { d=1; next } { print } END { exit (d ? 9 : 0) }') || cap_rc=$?
    if [ "$cap_rc" -eq 9 ]; then
      emit "$CONFLICT_STATE" "$file" "line(s) over $MAX_LINE_LENGTH chars cannot be scanned for conflict markers — split/relocate the minified asset or raise MAX_LINE_LENGTH"
    fi
    [ -n "$content" ] || continue
    m=$(grep -anE -- "$CONFLICT_RE" <<<"$content" | grep -ivE '(^[0-9]+:|[[:space:]])(#|//|/\*|<!--)[[:space:]]*scaffold-allow' || true)
    if [ -n "$m" ]; then
      emit "$CONFLICT_STATE" "$file" "merge-conflict marker — resolve the conflict before committing"
      printf '%s\n' "$m" | head -3 | sed 's/^/    /' >&2 || true
    fi
  done
fi

# --- 2. case-only filename collisions --------------------------------------
# bash 3.2 (macOS) has no associative arrays and no ${var,,}, so lowercase each
# path once with tr into a parallel array, then compare pairwise (O(n^2) string
# compares, no subprocess in the inner loop). NUL-delimited input means a path
# may legitimately contain a newline, so we never split on newlines here.
CASE_STATE=$(cfg rule-state case-collision); [ -n "$CASE_STATE" ] || CASE_STATE=error
if [ "$CASE_STATE" != disabled ]; then
  LOWER=()
  for f in "${FILES[@]}"; do
    LOWER+=("$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')")
  done

  n=${#FILES[@]}
  for ((i = 0; i < n; i++)); do
    for ((j = i + 1; j < n; j++)); do
      if [ "${LOWER[$i]}" = "${LOWER[$j]}" ] && [ "${FILES[$i]}" != "${FILES[$j]}" ]; then
        emit "$CASE_STATE" "${FILES[$j]}" "case-only filename collision with '${FILES[$i]}' — breaks case-insensitive checkouts (macOS/Windows)"
      fi
    done
  done
fi

# --- 3. hidden Unicode (bidi / zero-width / tag) ---------------------------
# A blob is "binary" (a NUL in the first 8 KB) — the NULs survive the pipe into
# wc (a bash var can't hold NUL, so we count in the pipeline).
is_binary() {
  local n
  # `|| true`: a missing/unreadable path (git show fails) is simply "not binary"
  # under set -e/pipefail, not a hard error.
  n=$(git show ":0:$1" 2>/dev/null | head -c 8192 | LC_ALL=C tr -dc '\000' | wc -c | tr -d ' ' || true)
  [ "${n:-0}" -gt 0 ]
}

# The binary skip below exists ONLY so real images/media/archives (which
# legitimately contain the scanned byte sequences) don't false-positive. But a
# lone NUL is attacker-controlled: prepending one to an agent-read text file
# (AGENTS.md, coding-rules.md, any .md/source) used to flip is_binary and skip
# the ONLY scan that defends those files against bidi overrides / the Rules File
# Backdoor. So the skip now requires BOTH a binary blob AND a known binary-asset
# EXTENSION — a text/source/agent file (or any unknown/extensionless type) is
# scanned as text regardless of an injected NUL ($() strips NULs before the scan).
is_binary_asset_name() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.png|*.jpg|*.jpeg|*.gif|*.bmp|*.ico|*.webp|*.tif|*.tiff|*.heic|*.avif|*.psd|\
    *.pdf|*.zip|*.gz|*.tgz|*.bz2|*.xz|*.zst|*.7z|*.rar|*.jar|*.war|*.ear|\
    *.mp3|*.mp4|*.m4a|*.wav|*.avi|*.mov|*.mkv|*.flac|*.ogg|*.opus|*.webm|\
    *.woff|*.woff2|*.ttf|*.otf|*.eot|\
    *.so|*.dylib|*.dll|*.exe|*.bin|*.o|*.a|*.lib|*.class|*.wasm|*.pyc|*.pyo|\
    *.parquet|*.pack|*.idx|*.db|*.sqlite|*.sqlite3|*.mo|*.dat) return 0 ;;
  esac
  return 1
}

HIDDEN_STATE=$(cfg rule-state hidden-unicode); [ -n "$HIDDEN_STATE" ] || HIDDEN_STATE=error
if [ "$HIDDEN_STATE" != disabled ]; then
  # Literal UTF-8 bytes via $'...' so this needs no \xHH regex support (BSD grep
  # / bash 3.2 safe) — matched under LC_ALL=C so each byte is one "character":
  #   C2 AD        U+00AD soft hyphen (invisible, splits a keyword mid-word)
  #   D8 9C        U+061C arabic letter mark (bidi, invisible)
  #   E2 80 8B-8C  zero-width space / non-joiner
  #   E2 80 8D     zero-width JOINER: NOT in HIDDEN_RE; see ZWJ below
  #   E2 80 8E-8F  U+200E/U+200F left-to-right / right-to-left mark (bidi)
  #   E2 80 AA-AE  bidi embeddings & overrides (Trojan Source, CVE-2021-42574)
  #   E2 81 A0     word joiner;   E2 81 A6-A9  bidi isolates
  #   EF BB BF     zero-width no-break space (a mid-file BOM)
  #   F3 A0 80-87 ··  U+E0000–U+E01FF: the tag block (U+E0000–E007F, invisible
  #                "tag" smuggling) AND the variation selectors supplement
  #                (U+E0100–U+E01EF). The latter is the byte-per-codepoint
  #                smuggling channel used to hide a whole instruction ("SYSTEM:
  #                ignore all prior rules") inside an agent-read file; it was
  #                the one range the original tag-block-only expression missed,
  #                and it is exactly the Rules File Backdoor surface.
  # Err toward catching MORE here: a false positive costs one `scaffold-allow`
  # comment, a false negative costs an agent following smuggled instructions.
  # Deliberately NOT matched: EF B8 80-8F (U+FE00–FE0F, variation selectors 1-16),
  # which follow emoji legitimately all over ordinary prose.
  #
  # ZWJ (U+200D, E2 80 8D) is allowed between two emoji codepoints and refused
  # anywhere else. It is judged by rewriting, not by the regex above, because
  # bash 3.2 / BSD grep have no lookbehind. For a line that holds a ZWJ:
  #   1. remap any pre-existing 0x01 byte to 0x02 (so the marker is ours alone;
  #      remapped, not deleted, so a stray byte can't make a ZWJ look adjacent),
  #   2. turn a ZWJ that FOLLOWS an emoji into a 0x01 marker,
  #   3. delete a marker that is FOLLOWED by an emoji (the ZWJ was inside a
  #      sequence). What is left over is a ZWJ with no emoji on one side: either
  #      a raw ZWJ (no emoji before it) or a marker (no emoji after it).
  # ZWJ_RE = HIDDEN_RE plus the raw ZWJ bytes plus 0x01 matches both, so
  # a lone, leading, trailing, doubled or letter-adjacent ZWJ is still caught
  # (and a chain of joined emoji works because step 2 never consumes the emoji).
  # "Emoji" is, as UTF-8 bytes:
  #   F0 9F 8C-AB xx   U+1F300-U+1FAFF (pictographs, incl. the skin tones
  #                    U+1F3FB-U+1F3FF = F0 9F 8F BB-BF)
  #   E2 98-9E xx      U+2600-U+27BF (misc symbols, dingbats: U+2640, U+2764)
  #   EF B8 8F         U+FE0F variation selector 16 (allowed BEFORE a ZWJ only)
  EMOJI_NEXT=$'\xf0\x9f[\x8c-\xab][\x80-\xbf]|\xe2[\x98-\x9e][\x80-\xbf]'
  EMOJI_PREV="$EMOJI_NEXT"$'|\xef\xb8\x8f'
  ZWJ_BYTES=$'\xe2\x80\x8d'
  ZWJ_MARK=$'\001'
  HIDDEN_RE=$'\xc2\xad|\xd8\x9c|\xe2\x80[\x8b\x8c\x8e\x8f\xaa-\xae]|\xe2\x81[\xa0\xa6-\xa9]|\xef\xbb\xbf|\xf3\xa0[\x80-\x87][\x80-\xbf]'
  ZWJ_RE="$HIDDEN_RE|$ZWJ_BYTES|$ZWJ_MARK"
  # Locale paths skip this rule only (see the header). Shipped defaults here; a
  # project adds more under [rules.hidden-unicode] `exclude`.
  HIDDEN_EXCLUDES='locales/*,locale/*,i18n/*,*/locales/*,*/locale/*,*/i18n/*,*.po,*.pot'
  for file in "${FILES[@]}"; do
    # Per-rule path exclude: a locale file skips this scan entirely, and says so
    # once (it is a deliberate weakening, so it is never silent).
    if path_excluded "$file" "$HIDDEN_EXCLUDES" hidden-unicode; then
      if [ "$CI_MODE" -eq 1 ]; then
        echo "::notice file=$(ghesc prop "$file")::$(ghesc data "hidden-unicode scan skipped (locale path or .scaffold.toml exclude)")"
      else
        echo "- $file: hidden-unicode scan skipped (locale path or .scaffold.toml exclude)"
      fi
      continue
    fi
    # Skip only a genuine binary ASSET (binary content AND a binary extension) —
    # never a text/agent file whose "binary-ness" is one injected NUL (see above).
    if is_binary "$file" && is_binary_asset_name "$file"; then continue; fi
    # FAIL CLOSED on an over-cap line (check-secrets parity). An unscannable line
    # in an agent-read file is exactly the Trojan-Source / Rules-File-Backdoor
    # surface this branch defends, so a dropped line is reported, not swallowed.
    cap_rc=0
    content=$(git show ":0:$file" 2>/dev/null | LC_ALL=C tr -d '\000' \
                | LC_ALL=C awk -v n="$MAX_LINE_LENGTH" 'length > n { d=1; next } { print } END { exit (d ? 9 : 0) }') || cap_rc=$?
    if [ "$cap_rc" -eq 9 ]; then
      emit "$HIDDEN_STATE" "$file" "line(s) over $MAX_LINE_LENGTH chars cannot be scanned for hidden Unicode (Trojan Source / Rules File Backdoor surface) — split/relocate the minified asset or raise MAX_LINE_LENGTH"
    fi
    [ -n "$content" ] || continue
    # A legitimate leading BOM is allowed; strip one before scanning so only a
    # mid-file occurrence trips the EF-BB-BF branch. Index-based check-and-slice,
    # not the equivalent-looking pattern strip ${content#$'\xef\xbb\xbf'}: even
    # with the LC_ALL=C above, the pattern form still routes through bash's
    # glob matcher and was measurably slow on a large file (see LC_ALL=C note
    # near the top); substring extraction by index never invokes it.
    if [ "${content:0:3}" = $'\xef\xbb\xbf' ]; then
      content=${content:3}
    fi
    # Emoji-ZWJ allowance (see ZWJ above). Only a file that holds a ZWJ pays for it.
    hre=$HIDDEN_RE
    if LC_ALL=C grep -aqF -- "$ZWJ_BYTES" <<<"$content"; then
      hre=$ZWJ_RE
      content=$(printf '%s\n' "$content" | LC_ALL=C tr "$ZWJ_MARK" '\002' \
                  | LC_ALL=C sed -E "s/($EMOJI_PREV)$ZWJ_BYTES/\\1$ZWJ_MARK/g" \
                  | LC_ALL=C sed -E "s/$ZWJ_MARK($EMOJI_NEXT)/\\1/g")
    fi
    m=$(LC_ALL=C grep -anE -- "$hre" <<<"$content" \
          | grep -ivE '(^[0-9]+:|[[:space:]])(#|//|/\*|<!--)[[:space:]]*scaffold-allow' || true)
    if [ -n "$m" ]; then
      emit "$HIDDEN_STATE" "$file" "hidden Unicode control char (bidi / zero-width / tag / variation selector), strip it; this is the 'Rules File Backdoor' / Trojan Source surface"
      # Never echo the raw invisible bytes back to a terminal/CI log — sanitize
      # non-printing bytes to '.' so the offending line(s) are reviewable.
      printf '%s\n' "$m" | LC_ALL=C sed 's/[^[:print:][:space:]]/./g' | head -3 | sed 's/^/    /' >&2 || true
    fi
  done
fi

exit $FAILED
