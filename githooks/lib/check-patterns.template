#!/usr/bin/env bash
# .githooks/lib/check-patterns — forbidden-pattern scan for source files.
# Reads NUL-separated file paths on stdin (produced by `git ... -z`). Auto-
# discovers every `.forbidden-patterns/*.txt` (except secrets.txt, which is
# check-secrets' domain) and scans the files whose extension the pattern file
# claims. A pattern file declares its extensions with a header line:
#   # scaffold-extensions: py
#   # scaffold-extensions: ts tsx js jsx vue
# so a new language is added by dropping `<lang>.txt` with that header — no edit
# to this script. backend.txt / frontend.txt / shell.txt have a built-in
# fallback mapping for backward compatibility.
# A pattern file may ALSO name literal filenames / basename globs with a second,
# optional header:
#   # scaffold-filenames: Dockerfile Dockerfile.* Makefile *.mk *.yml *.yaml
# for rules that must reach files carrying no extension of their own — a
# Dockerfile, a Makefile, CI workflow YAML, package.json scripts — where
# `curl | bash` and `rm -rf /` are every bit as dangerous as in a *.sh. It is
# opt-in per file: no header means extension-only dispatch, so adding the
# mechanism changes no existing pattern file's behaviour, and there is
# deliberately NO built-in fallback (an absent header means "not requested").
# BOTH dispatches match case-INSENSITIVELY (`leak.JS`, `DOCKERFILE`); the
# patterns themselves stay case-sensitive.
# Pattern format: <regex><TAB><description>
# (TAB is the field separator so regex can use literal `|` alternation.)
#
# Like check-secrets, this scans the STAGED/INDEXED BLOB via
# `git show ":0:<path>"` rather than the working-tree file, so symlinks, NUL
# bytes, and post-stage edits cannot hide content from the scan. Every grep
# passes -a/--text for the same reason.
#
# A `scaffold-allow` marker exempts a line, but ONLY after a comment leader
# (`#`, `//`, `/*`, `<!--`) at start-of-line or after whitespace — like `# noqa`.
# Bare `--` was dropped as a leader (cross-language bypass); see check-secrets
# for why inline suppression isn't a hostile-committer boundary. Use sparingly.
#
# Output: human-readable on tty; ::error file=...:: when --ci is passed.
# Exit:   0 if all OK, 1 if any violation.

set -euo pipefail

CI_MODE=0
[ "${1:-}" = "--ci" ] && CI_MODE=1

# Escape a value for a GitHub workflow command (see check-secrets). `data` mode
# escapes %, CR, LF; `prop` mode (file=) additionally escapes : and , so a
# crafted filename/description can't forge or truncate the annotation.
ghesc() {
  local s=$2
  s=${s//'%'/%25}; s=${s//$'\r'/%0D}; s=${s//$'\n'/%0A}
  if [ "$1" = prop ]; then s=${s//:/%3A}; s=${s//,/%2C}; fi
  printf '%s' "$s"
}

# Per-project overrides (.scaffold.toml via the sibling scaffold-config helper).
# `cfg` fails open to empty output when the helper is missing (older install);
# the caller then treats every rule as fully enforced (fail safe).
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_BIN="$SELF_DIR/scaffold-config"
cfg() { [ -x "$CONFIG_BIN" ] || return 0; "$CONFIG_BIN" "$@" 2>/dev/null || true; }

# Emit one finding at the resolved severity. `warn` reports without failing the
# build (a deliberate, audited downgrade); `error` fails. FAILED is the global
# set below; this is only ever called after it exists.
report() {
  local state=$1 file=$2 desc=$3 matches=$4
  if [ "$state" = warn ]; then
    if [ "$CI_MODE" -eq 1 ]; then
      echo "::warning file=$(ghesc prop "$file")::$(ghesc data "$desc")"
    else
      echo "! $file: $desc (warn — .scaffold.toml override)"
      printf '%s\n' "$matches" | head -3 | sed 's/^/    /' || true
    fi
  else
    if [ "$CI_MODE" -eq 1 ]; then
      echo "::error file=$(ghesc prop "$file")::$(ghesc data "$desc")"
    else
      echo "✗ $file: $desc"
      printf '%s\n' "$matches" | head -3 | sed 's/^/    /' || true
    fi
    FAILED=1
  fi
}

# A config that EXISTS but cannot arm its scan — unreadable, gutted to zero
# patterns, or every pattern an invalid ERE — must FAIL, not pass silently: the
# denylist it configures is disarmed and the commit has to be refused. Same
# treatment and same wording shape as check-secrets' missing/empty/all-invalid
# guards; the only difference is `FAILED=1` instead of `exit 1`, so the
# remaining pattern files still get scanned and every problem is reported in one
# run. FAILED is the global set below; this is only ever called after it exists.
fail_closed() {
  if [ "$CI_MODE" -eq 1 ]; then echo "::error::$1"; else echo "✗ $1" >&2; fi
  FAILED=1
}

# Cap the maximum scanned LINE length (see check-secrets): one very long line
# can make the combined ERE hang the hook/CI. Over-long lines are dropped with
# a warning. Linear awk length check; the ERE on a long line is not linear.
MAX_LINE_LENGTH=${MAX_LINE_LENGTH:-50000}
case "$MAX_LINE_LENGTH" in
  ''|*[!0-9]*) echo "error: MAX_LINE_LENGTH must be a positive integer, got: $MAX_LINE_LENGTH" >&2; exit 2 ;;
esac
[ "$MAX_LINE_LENGTH" -gt 0 ] || { echo "error: MAX_LINE_LENGTH must be > 0" >&2; exit 2; }

FILES=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] && FILES+=("$f")
done

scan() {
  # $2 is the raw `# scaffold-filenames:` header (a space-separated glob list);
  # it travels as a single string because a second array can't ride in "$@".
  local config=$1 names=$2
  shift 2
  local exts=("$@")

  # Nothing staged, nothing to scan. This is the one genuinely quiet path — it
  # says nothing about whether the config is armed — and it is checked FIRST so
  # a delete-only or empty commit never trips the fail-closed guards below.
  [ ${#FILES[@]} -eq 0 ] && return 0

  # Everything from here FAILS CLOSED (check-secrets parity). scan() is only
  # reached for a path the `.forbidden-patterns/*.txt` glob actually matched, so
  # the config EXISTS: unreadable/gutted/corrupt means it was installed and then
  # disarmed, which is a disabled scan, not a pre-install checkout. ABSENCE is
  # the case that stays lenient and never reaches here: backend/frontend/<lang>
  # .txt are installed conditionally, so a missing one is indistinguishable from
  # "this project never had that language". shell.txt and secrets.txt are the
  # two install.sh writes in every mode — their absence IS distinguishable, and
  # is caught by the CI guard at the bottom of this file.
  if [ ! -f "$config" ] || [ ! -r "$config" ]; then
    fail_closed "$config is not a readable file — the forbidden-pattern rules it configures do not run. Restore it (use 'git commit --no-verify' if intended)."
    return 0
  fi

  # Rule-id prefix for .scaffold.toml lookups: the pattern file's stem, e.g.
  # `php` for php.txt. A rule's full id is "<stem>/<description>".
  local stem
  stem=$(basename "$config" .txt)

  local raw_patterns=() raw_descs=()
  local line pattern description
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    # Require a real TAB separator (see check-secrets): a line without one would
    # become a whole-line pattern with an empty description. Skip + warn.
    case "$line" in
      *$'\t'*) ;;
      *) echo "warning: $config: line has no TAB separator, skipped: $line" >&2; continue ;;
    esac
    pattern=${line%%$'\t'*}
    description=${line#*$'\t'}
    [ -z "$pattern" ] && continue
    raw_patterns+=("$pattern")
    raw_descs+=("$description")
  done <"$config"

  # A present-but-EMPTY config (every rule deleted or commented out) is the
  # gutting analogue of deleting the file: it disables this file's whole rule set
  # in a single commit while dodging pre-commit's DELETED_CONFIG guard, which
  # only ever sees a full removal (the diff is an M, not a D). Fail CLOSED at
  # BOTH gates, exactly as check-secrets does for secrets.txt.
  if [ ${#raw_patterns[@]} -eq 0 ]; then
    fail_closed "$config has no patterns — every forbidden-pattern rule it configures is disabled. Restore its patterns (use 'git commit --no-verify' or remove the guardrails job if intended)."
    return 0
  fi

  # Validate each pattern up-front. An invalid ERE here would otherwise
  # poison the combined regex (silently dropping every file) and produce
  # cryptic per-file grep errors. `printf '' | grep -E p` returns 1
  # (no match) for valid patterns and writes to stderr for invalid ones —
  # so empty stderr means valid.
  local patterns=() descriptions=()
  local i p_err
  for i in "${!raw_patterns[@]}"; do
    p_err=$(printf '' | grep -E -- "${raw_patterns[$i]}" 2>&1 1>/dev/null || true)
    if [ -n "$p_err" ]; then
      echo "warning: $config: invalid pattern dropped: ${raw_patterns[$i]} — $p_err" >&2
      continue
    fi
    patterns+=("${raw_patterns[$i]}")
    descriptions+=("${raw_descs[$i]}")
  done

  # Every configured pattern was an invalid ERE and got dropped above, so the
  # scan would look for nothing at all — one bad character per line is a quieter
  # gutting than deleting them. Fail CLOSED, same reasoning as the guard above.
  if [ ${#patterns[@]} -eq 0 ]; then
    fail_closed "$config has no valid patterns (all were invalid regexes) — every forbidden-pattern rule it configures is disabled. Fix the patterns (use 'git commit --no-verify' if intended)."
    return 0
  fi

  # Combine all patterns into one ERE so a single grep call per file decides
  # whether to drop into the per-pattern attribution loop. Cuts grep calls
  # from O(P*F) to F + matching_files*P — large repos see a big speedup.
  local combined=""
  local p
  for p in "${patterns[@]}"; do
    if [ -z "$combined" ]; then
      combined="(${p})"
    else
      combined="${combined}|(${p})"
    fi
  done

  # Validate the COMBINED regex. If individually-valid patterns form an invalid
  # combined ERE, FAIL CLOSED: skip the pre-filter and scan every file
  # per-pattern, rather than letting a grep error be swallowed as "no match".
  local use_prefilter=1 c_err
  c_err=$(printf '' | grep -E -- "$combined" 2>&1 1>/dev/null || true)
  if [ -n "$c_err" ]; then
    echo "warning: $config: combined pattern invalid, scanning per-pattern (fail-closed): $c_err" >&2
    use_prefilter=0
  fi

  local file ext keep content cap_rc pat desc m base n
  # Word-split the `# scaffold-filenames:` header once, not once per file.
  local name_globs=()
  # shellcheck disable=SC2086  # word-splitting the header's glob list is intentional
  for n in $names; do name_globs+=("$n"); done

  for file in "${FILES[@]}"; do
    keep=0
    # Case-INSENSITIVE dispatch, scoped to the dispatch only. On macOS/Windows
    # checkouts `Utils.JS`, `Script.PY` and `Component.JSX` are ordinary files, so
    # a case-SENSITIVE suffix test made a one-character rename a bypass of every
    # rule in every language denylist — the same bug class already fixed at high
    # severity in check-filenames (CHANGELOG A4, `.PEM`/`.ENV`/`ID_RSA`). The
    # PATTERN greps below stay case-sensitive (-anE), so `Console.log` is still
    # not a match for `console.log`; only the file selection folds case.
    shopt -s nocasematch
    if [ ${#exts[@]} -gt 0 ]; then
      for ext in "${exts[@]}"; do
        case "$file" in *."$ext") keep=1; break ;; esac
      done
    fi
    # Then the optional literal-filename globs. `curl | bash`, `rm -rf /` and
    # `chmod 777` are exactly as dangerous in a Dockerfile, a Makefile, a CI
    # workflow YAML or a package.json script, and none of those carries a `.sh`
    # extension — an extensionless `bin/deploy` cannot be named by an extension
    # header at all. Each glob is tried against the BASENAME (so `Dockerfile`
    # catches `docker/Dockerfile`) and against the full path (so a header can name
    # a directory glob such as `bin/*` — only for directories known to hold TEXT,
    # since a compiled binary is one over-long line and trips the cap guard below).
    # The globs are unquoted on purpose — they are patterns, not values.
    if [ "$keep" -eq 0 ] && [ ${#name_globs[@]} -gt 0 ]; then
      base=${file##*/}
      for n in "${name_globs[@]}"; do
        # shellcheck disable=SC2254  # $n is a glob pattern by design
        case "$base" in $n) keep=1; break ;; esac
        # shellcheck disable=SC2254  # $n is a glob pattern by design
        case "$file" in $n) keep=1; break ;; esac
      done
    fi
    shopt -u nocasematch
    [ "$keep" -eq 1 ] || continue

    # Scan the staged blob, not the working-tree path (see header). Strip NUL
    # bytes FIRST: a C-string awk (macOS/BSD) truncates a record at an embedded
    # NUL, so a forbidden pattern placed after a NUL byte would be silently lost —
    # the same NUL-injection bypass the -a/--text greps below defend against.
    # awk (linear) then drops over-long lines so the combined ERE never sees them.
    cap_rc=0
    content=$(git show ":0:$file" 2>/dev/null | LC_ALL=C tr -d '\000' | awk -v n="$MAX_LINE_LENGTH" 'length > n { d=1; next } { print } END { exit (d ? 9 : 0) }') || cap_rc=$?
    if [ "$cap_rc" -eq 9 ]; then
      # FAIL CLOSED (check-secrets/check-hygiene parity). A forbidden pattern on a
      # >MAX_LINE_LENGTH line was dropped before the ERE (the ReDoS guard), but an
      # unscannable line must not pass silently as it used to (warn + exit 0).
      over="line(s) over $MAX_LINE_LENGTH chars cannot be scanned for forbidden patterns — split/relocate the minified asset or raise MAX_LINE_LENGTH"
      if [ "$CI_MODE" -eq 1 ]; then
        echo "::error file=$(ghesc prop "$file")::$(ghesc data "$over")"
      else
        echo "✗ $file: $over"
      fi
      FAILED=1
    fi
    [ -n "$content" ] || continue

    if [ "$use_prefilter" -eq 1 ]; then
      # -anE (NOT -i): backend/frontend/shell patterns are case-SENSITIVE, so
      # identifiers like `Alert(`, `Console.log`, `Print(` are not false matches.
      # -a keeps grep in text mode; check-secrets is the case-insensitive one.
      grep -anE -- "$combined" <<<"$content" >/dev/null 2>&1 || continue
    fi

    for i in "${!patterns[@]}"; do
      pat="${patterns[$i]}"
      desc="${descriptions[$i]}"
      # Exempt only a comment-anchored marker (see check-secrets).
      m=$(grep -anE -- "$pat" <<<"$content" | grep -ivE '(^[0-9]+:|[[:space:]])(#|//|/\*|<!--)[[:space:]]*scaffold-allow' || true)
      [ -n "$m" ] || continue
      # Per-rule override: `disabled` skips the rule, `warn` reports without
      # failing, anything else (incl. missing config) enforces as `error`.
      local state
      state=$(cfg rule-state "$stem/$desc"); [ -n "$state" ] || state=error
      [ "$state" = disabled ] && continue
      report "$state" "$file" "$desc" "$m"
    done
  done
}

# Resolve which file extensions a pattern file applies to. An explicit
#   # scaffold-extensions: ext1 ext2 ...
# header (first matching comment line) wins, so a new language is added by just
# dropping a `<lang>.txt` with that header — no edit to this script. The three
# original files have a built-in fallback so an older copy without the header
# keeps working.
exts_for() {
  local cfg=$1 hdr
  # `|| true`: with `set -o pipefail`, grep's exit 1 on a header-less file would
  # otherwise abort the whole script from inside the caller's `$(...)` — silently,
  # before the no-header diagnostic below could ever be printed.
  hdr=$(grep -m1 -E '^#[[:space:]]*scaffold-extensions:' "$cfg" 2>/dev/null \
          | sed -E 's/^#[[:space:]]*scaffold-extensions:[[:space:]]*//; s/[[:space:]]+$//') || true
  if [ -n "$hdr" ]; then printf '%s' "$hdr"; return; fi
  case "$(basename "$cfg")" in
    backend.txt)  printf 'py' ;;
    frontend.txt) printf 'ts tsx js jsx vue' ;;
    shell.txt)    printf 'sh bash' ;;
    *)            printf '' ;;
  esac
}

# Resolve the OPTIONAL literal filenames / basename globs a pattern file also
# wants scanned:
#   # scaffold-filenames: Dockerfile Dockerfile.* Makefile *.mk *.yml *.yaml
# Opt-in per file and deliberately WITHOUT a built-in fallback mapping: an absent
# header means "not requested", never "use a default", so no existing pattern
# file changes behaviour when this script is upgraded.
filenames_for() {
  local cfg=$1 hdr
  # `|| true` for the same pipefail reason as exts_for — and here the header is
  # absent in every shipped pattern file, so it is the normal case, not an edge.
  hdr=$(grep -m1 -E '^#[[:space:]]*scaffold-filenames:' "$cfg" 2>/dev/null \
          | sed -E 's/^#[[:space:]]*scaffold-filenames:[[:space:]]*//; s/[[:space:]]+$//') || true
  printf '%s' "$hdr"
}

FAILED=0
# Auto-discover every pattern file. secrets.txt is check-secrets' domain (it
# scans all files, not by extension), so skip it here.
# Every fail_closed() below is additionally gated on FILES: with nothing staged
# there is nothing this run could have missed, and a silent no-op run must stay
# silent (same quiet path scan() honours first).
for cfg in .forbidden-patterns/*.txt; do
  if [ ! -e "$cfg" ]; then
    # Two different things land here. An unexpanded glob (no `.forbidden-patterns/`
    # at all — a pre-install checkout) is the lenient case and stays quiet. A
    # DANGLING SYMLINK is not: that entry WAS installed and now points at nothing,
    # so the rules it configured silently stopped running. `-L` tells them apart —
    # a broken link satisfies -L, an unexpanded glob string does not.
    if [ -L "$cfg" ] && [ ${#FILES[@]} -gt 0 ]; then
      fail_closed "$cfg is a broken symlink — the forbidden-pattern rules it configures do not run. Restore it (use 'git commit --no-verify' if intended)."
    fi
    continue
  fi
  case "$(basename "$cfg")" in secrets.txt) continue ;; esac
  cfg_exts=$(exts_for "$cfg")
  cfg_names=$(filenames_for "$cfg")
  if [ -z "$cfg_exts" ] && [ -z "$cfg_names" ]; then
    # The file is installed but names nothing to scan, so every rule in it is
    # dead. Fail CLOSED for the same reason as a gutted config: a headerless
    # pattern file is a disarmed denylist, not an absent one.
    [ ${#FILES[@]} -eq 0 ] || fail_closed "$cfg has no '# scaffold-extensions:' or '# scaffold-filenames:' header and no built-in mapping — none of its rules ever run. Add a header (use 'git commit --no-verify' if intended)."
    continue
  fi
  # shellcheck disable=SC2086  # word-splitting $cfg_exts into separate args is intentional
  scan "$cfg" "$cfg_names" $cfg_exts
done

# shell.txt and secrets.txt are the only two configs install.sh writes in EVERY
# mode (install.sh:237-238), so — unlike backend/frontend/<lang>.txt, whose
# absence is indistinguishable from "this project never installed that language"
# — a missing shell.txt server-side means the scan was DISABLED after install:
# `git rm --cached` + .gitignore (which pre-commit only notes), or a merged
# deletion. Fail CLOSED in CI only, exactly as check-secrets does for a missing
# secrets.txt; locally a fresh clone may not have run install.sh yet, so stay
# lenient there. Gated on FILES so a no-op run says nothing.
if [ "$CI_MODE" -eq 1 ] && [ ${#FILES[@]} -gt 0 ] && [ ! -f .forbidden-patterns/shell.txt ]; then
  fail_closed ".forbidden-patterns/shell.txt is missing — the shell forbidden-pattern scan (curl | bash, rm -rf /, chmod 777, --no-verify) is disabled. Restore it (or remove the guardrails job intentionally)."
fi

exit $FAILED
