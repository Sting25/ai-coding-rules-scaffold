#!/usr/bin/env bash
# .githooks/lib/check-patterns — forbidden-pattern scan for source files.
# Reads NUL-separated file paths on stdin (produced by `git ... -z`). Auto-
# discovers every `.forbidden-patterns/*.txt` (except secrets.txt, which is
# check-secrets' domain) and scans the files whose extension the pattern file
# claims. Extensions are matched CASE-INSENSITIVELY, so `src/BAD.PY` is scanned
# by backend.txt just like `src/bad.py`. A pattern file declares its extensions
# with a header line:
#   # scaffold-extensions: py
#   # scaffold-extensions: ts tsx js jsx vue svelte
# so a new language is added by dropping `<lang>.txt` with that header — no edit
# to this script. backend.txt / frontend.txt / shell.txt have a built-in
# fallback mapping for backward compatibility.
# Pattern format: <regex><TAB><description>
# (TAB is the field separator so regex can use literal `|` alternation.)
#
# Scope by pattern FILE (opt-in, for callers that run more than one tier):
#   CHECK_PATTERNS_INCLUDE  space-separated basenames; ONLY these are scanned
#   CHECK_PATTERNS_EXCLUDE  space-separated basenames; these are skipped
# e.g. a wrapper can run `CHECK_PATTERNS_INCLUDE=security.txt` against the
# whole tree and `CHECK_PATTERNS_EXCLUDE=security.txt` against changed files.
# Unset means every discovered file, which is what pre-commit and CI use.
# An INCLUDE that matches no file warns on stderr rather than scanning nothing
# silently (#149). Both names are matched whole, so `a.txt` never selects
# `a-extra.txt`.
#
# Like check-secrets, this scans the STAGED/INDEXED BLOB via
# `git show ":0:<path>"` rather than the working-tree file, so symlinks, NUL
# bytes, and post-stage edits cannot hide content from the scan. Every grep
# passes -a/--text for the same reason.
#
# A `scaffold-allow` marker exempts a line, but ONLY after a comment leader
# (`#`, `//`, `/*`, `<!--`) at start-of-line or after whitespace — like `# noqa`.
# Bare `--` was dropped as a leader (cross-language bypass); see check-secrets
# for why inline suppression isn't a hostile-committer boundary. Use sparingly.
#
# A pattern file that the install manifest (.githooks/.scaffold-manifest)
# records but that is no longer in the checkout fails CLOSED (#159). Auto-
# discovery alone cannot see a REMOVED config, only an absent one, and the two
# look identical; a manifest entry is what makes them different. A repo with no
# manifest entry, or no manifest at all, keeps the old silent behavior.
#
# Output: human-readable on tty; ::error file=...:: when --ci is passed.
# Exit:   0 if all OK, 1 if any violation.

set -euo pipefail

# CDPATH must not reach the `$(cd ... && pwd)` below. When cd resolves its
# argument through CDPATH it PRINTS the directory it landed in, and that line
# is captured ahead of pwd's, so the variable ends up holding two lines and
# every path built from it is wrong. Hooks are invoked by relative path, so a
# developer with CDPATH='.' in their shell profile hit this on every commit.
# Unset rather than `CDPATH= cd` so any later cd in this file is safe too.
unset CDPATH

CI_MODE=0
[ "${1:-}" = "--ci" ] && CI_MODE=1

# Escape a value for a GitHub workflow command (see check-secrets). `data` mode
# escapes %, CR, LF; `prop` mode (file=) additionally escapes : and , so a
# crafted filename/description can't forge or truncate the annotation.
ghesc() {
  local s=$2
  s=${s//'%'/%25}; s=${s//$'\r'/%0D}; s=${s//$'\n'/%0A}
  if [ "$1" = prop ]; then s=${s//:/%3A}; s=${s//,/%2C}; fi
  printf '%s' "$s"
}

# Per-project overrides (.scaffold.toml via the sibling scaffold-config helper).
# `cfg` fails open to empty output when the helper is missing (older install);
# the caller then treats every rule as fully enforced (fail safe).
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_BIN="$SELF_DIR/scaffold-config"
cfg() { [ -x "$CONFIG_BIN" ] || return 0; "$CONFIG_BIN" "$@" 2>/dev/null || true; }

# Emit one finding at the resolved severity. `warn` reports without failing the
# build (a deliberate, audited downgrade); `error` fails. FAILED is the global
# set below; this is only ever called after it exists.
report() {
  local state=$1 file=$2 desc=$3 matches=$4
  if [ "$state" = warn ]; then
    if [ "$CI_MODE" -eq 1 ]; then
      echo "::warning file=$(ghesc prop "$file")::$(ghesc data "$desc")"
    else
      echo "! $file: $desc (warn — .scaffold.toml override)"
      printf '%s\n' "$matches" | head -3 | sed 's/^/    /' || true
    fi
  else
    if [ "$CI_MODE" -eq 1 ]; then
      echo "::error file=$(ghesc prop "$file")::$(ghesc data "$desc")"
    else
      echo "✗ $file: $desc"
      printf '%s\n' "$matches" | head -3 | sed 's/^/    /' || true
    fi
    FAILED=1
  fi
}

# Cap the maximum scanned LINE length (see check-secrets): one very long line
# can make the combined ERE hang the hook/CI. Over-long lines are dropped with
# a warning. Linear awk length check; the ERE on a long line is not linear.
MAX_LINE_LENGTH=${MAX_LINE_LENGTH:-50000}
case "$MAX_LINE_LENGTH" in
  ''|*[!0-9]*) echo "error: MAX_LINE_LENGTH must be a positive integer, got: $MAX_LINE_LENGTH" >&2; exit 2 ;;
esac
[ "$MAX_LINE_LENGTH" -gt 0 ] || { echo "error: MAX_LINE_LENGTH must be > 0" >&2; exit 2; }

FILES=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] && FILES+=("$f")
done

scan() {
  local config=$1
  shift
  local exts=("$@")
  # config_usable() has already proven this is a readable regular file.
  [ ${#FILES[@]} -eq 0 ] && return 0

  # Fold the declared extensions to lowercase ONCE. The extension match below
  # folds the path too, so `src/BAD.PY` is scanned by backend.txt (`py`) exactly
  # like `src/bad.py`. Matching case-SENSITIVELY was a fail-OPEN bypass: a file
  # renamed to an upper- or mixed-case extension matched no arm, was dropped
  # before the scan, and committed with zero findings at both the hook and the
  # whole-tree CI gate. check-filenames already folds with tr for this reason;
  # this is the same convention. (check-size's extension list is a SKIP list, so
  # a case mismatch there fails CLOSED, more scanning, and is left alone.)
  local exts_lc=() ext
  for ext in "${exts[@]}"; do
    exts_lc+=("$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')")
  done

  # Rule-id prefix for .scaffold.toml lookups: the pattern file's stem, e.g.
  # `php` for php.txt. A rule's full id is "<stem>/<description>".
  local stem
  stem=$(basename "$config" .txt)

  local raw_patterns=() raw_descs=()
  local line pattern description
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    # Require a real TAB separator (see check-secrets): a line without one would
    # become a whole-line pattern with an empty description. Skip + warn.
    case "$line" in
      *$'\t'*) ;;
      *) echo "warning: $config: line has no TAB separator, skipped: $line" >&2; continue ;;
    esac
    pattern=${line%%$'\t'*}
    description=${line#*$'\t'}
    [ -z "$pattern" ] && continue
    raw_patterns+=("$pattern")
    raw_descs+=("$description")
  done <"$config"

  # A present-but-EMPTY pattern file (every rule line deleted or commented out)
  # is the gutting analogue of deleting it: one commit disarms the whole tier
  # while dodging the orchestrator's deletion guard, which only sees
  # --diff-filter=D. check-secrets has failed CLOSED on this since 3ef4ad9;
  # check-patterns silently returned 0, so `printf '# scaffold-extensions: py\n'
  # > .forbidden-patterns/backend.txt` committed with no output at all and every
  # backend rule gone. Same shape as check-secrets: a config that EXISTS yet
  # yields zero patterns fails closed at both gates. (ABSENCE is different and
  # still fine, a repo simply has no php.txt; that is the `[ -f ]` return above.)
  if [ ${#raw_patterns[@]} -eq 0 ]; then
    local emsg="$config has no patterns, the forbidden-pattern scan for $stem is disabled. Restore its patterns (use 'git commit --no-verify' or delete the file if intended)."
    if [ "$CI_MODE" -eq 1 ]; then echo "::error::$emsg"; else echo "✗ $emsg" >&2; fi
    FAILED=1
    return 0
  fi

  # Validate each pattern up-front. An invalid ERE here would otherwise
  # poison the combined regex (silently dropping every file) and produce
  # cryptic per-file grep errors. `printf '' | grep -E p` returns 1
  # (no match) for valid patterns and writes to stderr for invalid ones —
  # so empty stderr means valid.
  local patterns=() descriptions=()
  local i p_err
  for i in "${!raw_patterns[@]}"; do
    p_err=$(printf '' | grep -E -- "${raw_patterns[$i]}" 2>&1 1>/dev/null || true)
    if [ -n "$p_err" ]; then
      echo "warning: $config: invalid pattern dropped: ${raw_patterns[$i]} — $p_err" >&2
      continue
    fi
    patterns+=("${raw_patterns[$i]}")
    descriptions+=("${raw_descs[$i]}")
  done

  # Every configured pattern was an invalid ERE and got dropped, the config is
  # corrupt and this tier would silently scan for nothing. Fail CLOSED, same
  # reasoning as the empty-config guard above and the matching guard in
  # check-secrets.
  if [ ${#patterns[@]} -eq 0 ]; then
    local vmsg="$config has no valid patterns (all were invalid regexes), the forbidden-pattern scan for $stem is disabled. Fix the patterns (use 'git commit --no-verify' if intended)."
    if [ "$CI_MODE" -eq 1 ]; then echo "::error::$vmsg"; else echo "✗ $vmsg" >&2; fi
    FAILED=1
    return 0
  fi

  # Combine all patterns into one ERE so a single grep call per file decides
  # whether to drop into the per-pattern attribution loop. Cuts grep calls
  # from O(P*F) to F + matching_files*P — large repos see a big speedup.
  local combined=""
  local p
  for p in "${patterns[@]}"; do
    if [ -z "$combined" ]; then
      combined="(${p})"
    else
      combined="${combined}|(${p})"
    fi
  done

  # Validate the COMBINED regex. If individually-valid patterns form an invalid
  # combined ERE, FAIL CLOSED: skip the pre-filter and scan every file
  # per-pattern, rather than letting a grep error be swallowed as "no match".
  local use_prefilter=1 c_err
  c_err=$(printf '' | grep -E -- "$combined" 2>&1 1>/dev/null || true)
  if [ -n "$c_err" ]; then
    echo "warning: $config: combined pattern invalid, scanning per-pattern (fail-closed): $c_err" >&2
    use_prefilter=0
  fi

  local file file_lc keep content cap_rc pat desc m
  for file in "${FILES[@]}"; do
    keep=0
    file_lc=$(printf '%s' "$file" | tr '[:upper:]' '[:lower:]')
    for ext in "${exts_lc[@]}"; do
      case "$file_lc" in *."$ext") keep=1; break ;; esac
    done
    [ "$keep" -eq 1 ] || continue

    # Scan the staged blob, not the working-tree path (see header). Strip NUL
    # bytes FIRST: a C-string awk (macOS/BSD) truncates a record at an embedded
    # NUL, so a forbidden pattern placed after a NUL byte would be silently lost —
    # the same NUL-injection bypass the -a/--text greps below defend against.
    # awk (linear) then drops over-long lines so the combined ERE never sees them.
    cap_rc=0
    content=$(git show ":0:$file" 2>/dev/null | LC_ALL=C tr -d '\000' | awk -v n="$MAX_LINE_LENGTH" 'length > n { d=1; next } { print } END { exit (d ? 9 : 0) }') || cap_rc=$?
    if [ "$cap_rc" -eq 9 ]; then
      # FAIL CLOSED (check-secrets/check-hygiene parity). A forbidden pattern on a
      # >MAX_LINE_LENGTH line was dropped before the ERE (the ReDoS guard), but an
      # unscannable line must not pass silently as it used to (warn + exit 0).
      over="line(s) over $MAX_LINE_LENGTH chars cannot be scanned for forbidden patterns — split/relocate the minified asset or raise MAX_LINE_LENGTH"
      if [ "$CI_MODE" -eq 1 ]; then
        echo "::error file=$(ghesc prop "$file")::$(ghesc data "$over")"
      else
        echo "✗ $file: $over"
      fi
      FAILED=1
    fi
    [ -n "$content" ] || continue

    if [ "$use_prefilter" -eq 1 ]; then
      # -anE (NOT -i): backend/frontend/shell patterns are case-SENSITIVE, so
      # identifiers like `Alert(`, `Console.log`, `Print(` are not false matches.
      # -a keeps grep in text mode; check-secrets is the case-insensitive one.
      grep -anE -- "$combined" <<<"$content" >/dev/null 2>&1 || continue
    fi

    for i in "${!patterns[@]}"; do
      pat="${patterns[$i]}"
      desc="${descriptions[$i]}"
      # Exempt only a comment-anchored marker (see check-secrets).
      m=$(grep -anE -- "$pat" <<<"$content" | grep -ivE '(^[0-9]+:|[[:space:]])(#|//|/\*|<!--)[[:space:]]*scaffold-allow' || true)
      [ -n "$m" ] || continue
      # Per-rule override: `disabled` skips the rule, `warn` reports without
      # failing, anything else (incl. missing config) enforces as `error`.
      local state
      state=$(cfg rule-state "$stem/$desc"); [ -n "$state" ] || state=error
      [ "$state" = disabled ] && continue
      report "$state" "$file" "$desc" "$m"
    done
  done
}

# Resolve which file extensions a pattern file applies to. An explicit
#   # scaffold-extensions: ext1 ext2 ...
# header (first matching comment line) wins, so a new language is added by just
# dropping a `<lang>.txt` with that header — no edit to this script. The three
# original files have a built-in fallback so an older copy without the header
# keeps working.
#
# The fallback must stay in sync with what the shipped pattern file declares.
# It drifted once: frontend.txt gained `svelte` in its header while this arm
# still read `ts tsx js jsx vue`, so a header-less frontend.txt left every
# `.svelte` file (and with it the `{@html}` XSS rule) unscanned. backend.txt
# (`py`) and shell.txt (`sh bash`) match their headers exactly. A test strips
# the header and re-scans to keep the two definitions pinned together.
exts_for() {
  local cfg=$1 hdr
  hdr=$(grep -m1 -E '^#[[:space:]]*scaffold-extensions:' "$cfg" 2>/dev/null \
          | sed -E 's/^#[[:space:]]*scaffold-extensions:[[:space:]]*//; s/[[:space:]]+$//')
  if [ -n "$hdr" ]; then printf '%s' "$hdr"; return; fi
  case "$(basename "$cfg")" in
    backend.txt)  printf 'py' ;;
    frontend.txt) printf 'ts tsx js jsx vue svelte' ;;
    shell.txt)    printf 'sh bash' ;;
    *)            printf '' ;;
  esac
}

# A discovered config that EXISTS but is not a readable REGULAR file is a
# disarm, not an uninstalled tier. Measured: `rm backend.txt;
# ln -s /nonexistent backend.txt` made every `[ -f ]`/`-e` test false (test(1)
# follows the link), so the tier was skipped in silence with exit 0, while the
# orchestrator's deletion guard saw only a diff-filter T, not a D. Returns 1
# and prints, so the caller fails CLOSED. `-h` is checked first: a symlink to a
# real file is equally a disarm, since it points the scanner at content the
# repo does not track. Same guard and wording as check-secrets.
config_usable() {
  local c=$1 why=""
  if [ -h "$c" ]; then why="is a symlink, not a regular file"
  elif [ ! -f "$c" ]; then why="is not a regular file"
  elif [ ! -r "$c" ]; then why="is not readable"
  fi
  if [ -n "$why" ]; then
    local m="$c $why, the forbidden-pattern scan cannot read its patterns and is disabled. Restore it as a regular readable file (use 'git commit --no-verify' if intended)."
    if [ "$CI_MODE" -eq 1 ]; then echo "::error::$m"; else echo "✗ $m" >&2; fi
    return 1
  fi
  return 0
}

FAILED=0
INCLUDED=0
# Auto-discover every pattern file. secrets.txt is check-secrets' domain (it
# scans all files, not by extension), so skip it here. Then apply the optional
# INCLUDE/EXCLUDE basename filter documented in the header.
for cfg in .forbidden-patterns/*.txt; do
  # `-e` alone is not enough: a DANGLING symlink is not -e, so a config swapped
  # for one would be skipped here and never reach the config_usable() guard.
  # Both false still means "no glob match → literal string", which is skipped.
  if [ ! -e "$cfg" ] && [ ! -h "$cfg" ]; then continue; fi
  base=$(basename "$cfg")
  case "$base" in secrets.txt) continue ;; esac
  if [ -n "${CHECK_PATTERNS_INCLUDE:-}" ]; then
    case " $CHECK_PATTERNS_INCLUDE " in *" $base "*) ;; *) continue ;; esac
  fi
  if [ -n "${CHECK_PATTERNS_EXCLUDE:-}" ]; then
    case " $CHECK_PATTERNS_EXCLUDE " in *" $base "*) continue ;; esac
  fi
  INCLUDED=$((INCLUDED + 1))
  # Before exts_for(), which greps the file: on an unreadable config that grep
  # yields nothing, and a header-less-looking config falls through to the
  # "skipped" warning and exit 0, the fail-OPEN path this guard replaces.
  if ! config_usable "$cfg"; then
    FAILED=1
    continue
  fi
  cfg_exts=$(exts_for "$cfg")
  if [ -z "$cfg_exts" ]; then
    echo "warning: $cfg: no '# scaffold-extensions:' header and no built-in mapping — skipped" >&2
    continue
  fi
  # shellcheck disable=SC2086  # word-splitting $cfg_exts into separate args is intentional
  scan "$cfg" $cfg_exts
done

# --- a pattern file the installer wrote that is no longer here ---------------
# The discovery loop above can only iterate files that EXIST, so a config that
# was REMOVED is indistinguishable from a language this project never installed:
# both are absent, both scan nothing, both exit 0. That is the hole in #159.
# `git rm --cached .forbidden-patterns/backend.txt` leaves the file on disk for
# the person who ran it, so their hook stays armed, while CI's checkout and
# every fresh clone have no backend.txt at all, and there every backend rule
# stopped running with no output anywhere. Measured: violation present plus
# backend.txt exits 1; the same violation with backend.txt absent exits 0 and
# prints nothing.
#
# The install manifest (.githooks/.scaffold-manifest) supplies the half this
# scanner lacked. An ENTRY for a path means "the installer wrote this file
# here", so entry present plus file absent is unambiguously REMOVED and fails
# closed, exactly like a gutted or unreadable config above. The silent cases
# stay silent: no entry and no file is still "never installed" (a repo simply
# has no php.txt), and a repo with NO manifest at all, which is every install
# predating the manifest, falls back to precisely today's behavior rather than
# starting to fail on an old install. uninstall.sh removes the manifest in both
# its modes, so an uninstalled repo cannot be left failing either.
#
# THE SUPPORTED ROUTE OUT is `uninstall.sh --drop-lang=<name>`, which removes
# the pattern file and its manifest entry TOGETHER and so lands the repo in the
# "never installed" state above. The message names it, because the alternative a
# user reaches for otherwise — hand-editing a file whose own header says "do not
# edit" — is the habit this guard can least afford to teach. Nothing INFERS the
# drop: an entry whose file is absent is precisely the signal here, so pruning
# such entries automatically anywhere (manifest_flush, an install run) would
# make `git rm --cached` self-authorising and reopen this hole. install.sh
# stays purely additive for that reason; the removal lives on the removal
# script, behind an explicit flag naming the language.
#
# secrets.txt is skipped for the same reason the discovery loop skips it: it is
# check-secrets' domain, and check-secrets already fails closed on its absence.
# INCLUDE/EXCLUDE are honored so a wrapper scoped to one tier is not failed by
# another tier's removal. `-e` or `-h` means the path is still there in some
# form, which is config_usable()'s case (a dangling symlink), not this one.
#
# The manifest is written by the installer and lives in the project, while
# install-manifest.sh's read helpers are sourced only by install.sh and are not
# shipped into a hook, so they cannot be called from here. This reads the same
# `NF == 3` line shape those helpers parse, with the comment skip manifest_flush
# uses; a path containing a space is not NF == 3 and is skipped, exactly as
# _manifest_hash skips it.
SCAFFOLD_MANIFEST=".githooks/.scaffold-manifest"
if [ ${#FILES[@]} -gt 0 ] && [ -f "$SCAFFOLD_MANIFEST" ] && [ -r "$SCAFFOLD_MANIFEST" ]; then
  while IFS= read -r recorded; do
    [ -n "$recorded" ] || continue
    mbase=${recorded##*/}
    case "$mbase" in secrets.txt) continue ;; esac
    if [ -n "${CHECK_PATTERNS_INCLUDE:-}" ]; then
      case " $CHECK_PATTERNS_INCLUDE " in *" $mbase "*) ;; *) continue ;; esac
    fi
    if [ -n "${CHECK_PATTERNS_EXCLUDE:-}" ]; then
      case " $CHECK_PATTERNS_EXCLUDE " in *" $mbase "*) continue ;; esac
    fi
    if [ -e "$recorded" ] || [ -h "$recorded" ]; then continue; fi
    mname=${mbase%.txt}
    mmsg="$recorded is missing but $SCAFFOLD_MANIFEST records the scaffold installing it here, so it was removed and every forbidden-pattern rule it carries has stopped running, in CI and in every fresh clone. Restore it, or — if this project dropped that language on purpose — run 'uninstall.sh --drop-lang=$mname' from your scaffold checkout, which removes the file and its manifest entry together; do not hand-edit $SCAFFOLD_MANIFEST (use 'git commit --no-verify' if intended)."
    if [ "$CI_MODE" -eq 1 ]; then echo "::error::$mmsg"; else echo "✗ $mmsg" >&2; fi
    FAILED=1
  done <<EOF_MANIFEST
$(awk 'substr($0, 1, 1) == "#" { next }
       NF == 3 && $3 ~ "^\\.forbidden-patterns/[^/]+\\.txt$" { print $3 }' \
     "$SCAFFOLD_MANIFEST" 2>/dev/null || true)
EOF_MANIFEST
fi

if [ -n "${CHECK_PATTERNS_INCLUDE:-}" ] && [ "$INCLUDED" -eq 0 ]; then
  echo "warning: CHECK_PATTERNS_INCLUDE='$CHECK_PATTERNS_INCLUDE' matched no .forbidden-patterns/*.txt, nothing was scanned" >&2
fi

exit $FAILED
