#!/usr/bin/env node
/*
 * .githooks/lib/check-mutation-diff-ts: the Vitest/Stryker twin of
 * check-mutation-diff, the advisory mutation layer of the test-guard family.
 * The full rationale (red-green cannot prove a test constrains behaviour;
 * a survivor in a file red-green reported unevaluable is the highest-signal
 * finding) lives in check-mutation-diff, read that header first.
 *
 * MECHANISM. Stryker (pinned, see STRYKER_PIN) runs in a scratch copy of
 * HEAD (git archive, node_modules symlinked to the project's own) with a
 * config this script writes: `mutate` is the list of changed non-test source
 * files, the test runner is vitest, the reporter is the JSON report. Scoping
 * is FILE-level: every mutant in a changed file is evaluated, not only those
 * on changed lines. A stryker.config.* the project ships is not merged; the
 * diff run uses the scaffold's own config (a note says so).
 *
 * Stryker's process exit code is NOT the verdict (it crashes with a stack
 * trace and no report when `mutate` matches nothing). The verdict is read
 * from the report file only: absent or unparsable means exit 2.
 *
 * Status mapping: Killed and Timeout count as killed; Survived is survived;
 * NoCoverage is "no tests"; Ignored and Pending are "not checked"; anything
 * else (RuntimeError, CompileError) is "other".
 *
 * USAGE
 *   check-mutation-diff-ts --base <ref> [--ci] [--max-mutants N]
 *
 * Exit: 0 evaluated (survivors are advisory only), or nothing to mutate
 *       1 declined: more mutants than --max-mutants (a size limit, not a finding)
 *       2 could not evaluate (Stryker missing or the wrong version, no report,
 *         git failure, timeout)
 * Exit 2 is a FAILURE, not a skip.
 */
"use strict";

// An extensionless file takes its module type from the nearest package.json,
// so in a project with "type": "module" this runs as ESM and a bare require
// is undefined. Resolve built-ins in a way that works under both.
const load = typeof require === "function" ? require : process.getBuiltinModule;
const cp = load("child_process");
const fs = load("fs");
const os = load("os");
const path = load("path");

const STRYKER_PIN = "10.1.1";
const INSTALL_CMD = `npm install --no-save @stryker-mutator/core@${STRYKER_PIN} ` +
  `@stryker-mutator/vitest-runner@${STRYKER_PIN}`;
const TIMEOUT_MS = 1800000;
const TEST_RE = /\.(test|spec)\.[cm]?[jt]sx?$/;
const SRC_RE = /\.[cm]?[jt]sx?$/;
const NOISE_RE = /(^|\/)(node_modules|dist|build|coverage)\//;

class Timeout extends Error {}

function run(cmd, args, opts) {
  const r = cp.spawnSync(cmd, args, Object.assign(
    { encoding: "utf8", timeout: TIMEOUT_MS, maxBuffer: 64 * 1024 * 1024 }, opts || {}));
  if (r.error && r.error.code === "ETIMEDOUT") throw new Timeout();
  if (r.error) return { status: 127, stdout: "", stderr: String(r.error.message) };
  return { status: r.status === null ? 1 : r.status, stdout: r.stdout || "", stderr: r.stderr || "" };
}

function emit(sev, msg, ci) {
  if (ci) console.log(`::${sev}::${msg}`);
  else console.error(`  ${sev}: ${msg}`);
}

function isSource(p) {
  const base = path.posix.basename(p);
  return SRC_RE.test(p) && !NOISE_RE.test(p) && !TEST_RE.test(p) &&
    !/(^|\/)__tests__\//.test(p) && !/\.d\.[cm]?ts$/.test(p) && !/\.config\./.test(base);
}

function parseArgs(argv) {
  const a = { base: null, ci: false, maxMutants: 400 };
  for (let i = 0; i < argv.length; i++) {
    const v = argv[i];
    if (v === "--base") a.base = argv[++i];
    else if (v === "--ci") a.ci = true;
    else if (v === "--max-mutants") a.maxMutants = parseInt(argv[++i], 10);
    else { console.error(`unknown argument: ${v}`); process.exit(2); }
  }
  if (!a.base || Number.isNaN(a.maxMutants)) {
    console.error("usage: check-mutation-diff-ts --base <ref> [--ci] [--max-mutants N]");
    process.exit(2);
  }
  return a;
}

// Both Stryker packages must be installed at exactly the pinned version.
function verifyStryker(ci) {
  for (const name of ["core", "vitest-runner"]) {
    let v = null;
    try {
      v = JSON.parse(fs.readFileSync(
        path.join("node_modules", "@stryker-mutator", name, "package.json"), "utf8")).version;
    } catch (e) { /* not installed */ }
    if (v !== STRYKER_PIN) {
      emit("error", `@stryker-mutator/${name} ${v === null ? "is not installed" :
        `is ${v}, expected ${STRYKER_PIN}`}. This check is validated against the ` +
        `pinned version only. Install it with: ${INSTALL_CMD}`, ci);
      return 2;
    }
  }
  return 0;
}

function main() {
  const args = parseArgs(process.argv.slice(2));

  let pkg = "";
  try { pkg = fs.readFileSync("package.json", "utf8"); } catch (e) { /* none */ }
  if (!/"vitest"/.test(pkg)) {
    console.log("no Vitest project detected, nothing to mutate.");
    return 0;
  }
  const v = verifyStryker(args.ci);
  if (v) return v;

  const base = run("git", ["rev-parse", "--verify", `${args.base}^{commit}`]);
  const head = run("git", ["rev-parse", "--verify", "HEAD"]);
  if (base.status !== 0) {
    emit("error", `cannot resolve base ref '${args.base}'. In CI make sure the ` +
      "checkout has fetch-depth: 0.", args.ci);
    return 2;
  }
  if (head.status !== 0) {
    emit("error", "cannot resolve HEAD.", args.ci);
    return 2;
  }
  const baseSha = base.stdout.trim();
  const headSha = head.stdout.trim();

  const diff = run("git", ["diff", "-z", "--name-only", "--diff-filter=d", `${baseSha}...${headSha}`]);
  if (diff.status !== 0) {
    emit("error", `git diff failed: ${diff.stderr.trim()}`, args.ci);
    return 2;
  }
  const srcFiles = diff.stdout.split("\0").filter((p) => p && isSource(p)).sort();
  if (srcFiles.length === 0) {
    console.log("nothing to mutate, no changed non-test TypeScript source files in this diff.");
    return 0;
  }
  if (!fs.existsSync("node_modules")) {
    emit("error", "node_modules is missing; install the project's dependencies " +
      "first (npm ci).", args.ci);
    return 2;
  }
  const carried = fs.readdirSync(".").filter((f) => /^stryker\.(conf|config)\.[cm]?[jt]son?$/.test(f));
  if (carried.length) {
    console.error(`note: ${carried[0]} is not used by this diff run; the scaffold's own ` +
      "config scopes it to the changed files (file-level scoping only).");
  }

  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "mutdiff-ts-"));
  const wt = path.join(tmp, "wt");
  try {
    fs.mkdirSync(wt);
    const tar = path.join(tmp, "head.tar");
    let r = run("git", ["archive", "--format=tar", "-o", tar, headSha]);
    if (r.status === 0) r = run("tar", ["-xf", tar, "-C", wt]);
    if (r.status !== 0) {
      emit("error", `could not export HEAD: ${r.stderr.trim()}`, args.ci);
      return 2;
    }
    fs.rmSync(tar, { force: true });
    fs.symlinkSync(path.resolve("node_modules"), path.join(wt, "node_modules"), "dir");

    const reportRel = ".scaffold-mutation/report.json";
    fs.writeFileSync(path.join(wt, ".scaffold-stryker.json"), JSON.stringify({
      testRunner: "vitest",
      mutate: srcFiles,
      reporters: ["json"],
      jsonReporter: { fileName: reportRel },
      tempDirName: ".scaffold-stryker-tmp",
      incremental: false,
      cleanTempDir: true,
    }, null, 2));

    r = run("npx", ["--no-install", "stryker", "run", ".scaffold-stryker.json"], { cwd: wt });
    const outText = r.stdout + r.stderr;
    let files = null;
    try {
      const rep = JSON.parse(fs.readFileSync(path.join(wt, reportRel), "utf8"));
      if (rep && rep.files && typeof rep.files === "object") files = rep.files;
    } catch (e) { /* no report */ }
    if (files === null) {
      emit("error", "stryker run produced no readable report (initial test run " +
        "failed, a config error, or a crash); treating as unable to evaluate.", args.ci);
      console.log("--- last 40 line(s) of stryker output ---");
      console.log(outText.split("\n").slice(-40).join("\n"));
      return 2;
    }

    const perFile = {};
    for (const rel of Object.keys(files).sort()) {
      const s = { killed: 0, survived: 0, no_tests: 0, not_checked: 0, other: 0, total: 0 };
      for (const m of files[rel].mutants || []) {
        s.total++;
        if (m.status === "Killed" || m.status === "Timeout") s.killed++;
        else if (m.status === "Survived") s.survived++;
        else if (m.status === "NoCoverage") s.no_tests++;
        else if (m.status === "Ignored" || m.status === "Pending") s.not_checked++;
        else s.other++;
      }
      perFile[rel] = s;
    }
    const sum = (k) => Object.values(perFile).reduce((a, s) => a + s[k], 0);
    const total = sum("total");
    const killed = sum("killed");
    const badTotal = total - killed;
    const src = "stryker json report";

    if (total > args.maxMutants) {
      emit("warning", `${total} mutants across ${srcFiles.length} changed file(s) ` +
        `exceeds --max-mutants=${args.maxMutants}; evaluating that ` +
        "many would dominate CI time. Split the PR - a change this " +
        "large is not reviewable by any means available to you, " +
        "mutation testing included.", args.ci);
      return 1;
    }
    if (total === 0) {
      console.log("mutation OK: 0 mutants generated for the changed lines " +
        `(source: ${src}); nothing to evaluate.`);
      return 0;
    }
    if (badTotal === 0) {
      console.log(`mutation OK: ${total} mutants, all killed across ` +
        `${srcFiles.length} changed file(s) (source: ${src}).`);
      return 0;
    }
    for (const [rel, s] of Object.entries(perFile)) {
      if (s.survived + s.no_tests + s.not_checked + s.other) {
        emit("warning", `${rel}: ${s.survived} survived, ${s.no_tests} no ` +
          `tests, ${s.not_checked} not checked, ${s.other} ` +
          `other mutant(s) out of ${s.total} on this diff. A ` +
          "surviving or uncovered mutant means some changed line " +
          "has no test that actually constrains it.", args.ci);
      }
    }
    emit("notice", `mutation summary: ${killed} killed, ${badTotal} not killed ` +
      `(${total} total) across ${srcFiles.length} changed file(s), ` +
      `source: ${src}. Advisory only for this release ` +
      "(#145 point 4): none of this fails the build yet. A survivor " +
      "in a file check-red-green reported unevaluable is the " +
      "highest-signal finding above.", args.ci);
    return 0;
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

try {
  process.exitCode = main();
} catch (e) {
  if (e instanceof Timeout) {
    console.log("::error::mutation-diff check timed out. A mutation run too " +
      "slow to complete in CI is too slow to trust as a gate; scope " +
      "it to fewer files or raise the timeout deliberately.");
    process.exitCode = 2;
  } else {
    throw e;
  }
}
