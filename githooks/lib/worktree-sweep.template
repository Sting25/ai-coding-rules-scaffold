#!/usr/bin/env bash
# .githooks/lib/worktree-sweep: remove the temp worktrees an earlier test-guard
# gate run left behind (#221). Called at the start of each run by
# check-red-green, check-mutation-diff and their TypeScript twins.
#
#   worktree-sweep            no arguments; exits 0 always (best effort)
#
# WHY. A gate that is killed leaves a directory under the system temp dir and,
# for the Python pair, a registration in .git/worktrees. `git worktree prune`
# drops only registrations whose directory is already gone, so a killed run's
# worktree (directory still there) stays until the OS clears tmp. SIGTERM is
# handled in the gates themselves; SIGKILL cannot be trapped, so this sweep is
# the backstop.
#
# WHAT IT TOUCHES. Only a directory this gate family created: its name is
# redgreen-* or mutdiff-* (the TypeScript pair: redgreen-ts-*, mutdiff-ts-*), it
# sits directly in the system temp dir (physical path compared, so a symlink
# cannot point the sweep elsewhere) and it holds the gate's own `wt` directory.
# A registered worktree anywhere else, a locked one, and a younger one are left
# alone.
#
# AGE. A run in progress must survive a second run starting beside it (a hook
# and CI, or two sessions), so nothing younger than
# SCAFFOLD_WORKTREE_SWEEP_MAX_AGE seconds (default 7200: longer than two
# gate-run timeouts) is removed. 0 removes every match, for a test or a known
# dead machine.
set -u

age=${SCAFFOLD_WORKTREE_SWEEP_MAX_AGE:-7200}
case $age in '' | *[!0-9]*) age=7200 ;; esac
git rev-parse --git-dir >/dev/null 2>&1 || exit 0

# Physical temp roots. TMPDIR first (it is where mkdtemp puts the gates' dirs),
# then the two fixed system locations.
roots=()
for r in "${TMPDIR:-}" /tmp /var/tmp; do
  [ -n "$r" ] && [ -d "$r" ] || continue
  p=$(cd -P "$r" 2>/dev/null && pwd -P) || continue
  roots+=("$p")
done
[ "${#roots[@]}" -gt 0 ] || exit 0

in_roots() {
  local x
  for x in "${roots[@]}"; do [ "$1" = "$x" ] && return 0; done
  return 1
}

# old_enough <dir>: true when <dir> is older than the age limit.
old_enough() {
  [ "$age" -eq 0 ] && return 0
  [ -n "$(find "$1" -maxdepth 0 -mmin "+$(((age + 59) / 60))" 2>/dev/null)" ]
}

# gate_dir <name>: true for a name this gate family creates.
gate_dir() {
  case $1 in
    redgreen-* | mutdiff-*) return 0 ;;
  esac
  return 1
}

# sweep_dir <tmp-dir>: remove a gate temp dir after the guards above.
sweep_dir() {
  local d=$1 phys parent
  phys=$(cd -P "$d" 2>/dev/null && pwd -P) || return 0
  parent=${phys%/*}
  gate_dir "${phys##*/}" || return 0
  in_roots "$parent" || return 0
  [ -d "$phys/wt" ] || return 0
  old_enough "$phys" || return 0
  if [ -e "$phys/wt/.git" ]; then
    git worktree remove --force "$phys/wt" >/dev/null 2>&1 || true
  fi
  rm -r -f -- "$phys" 2>/dev/null || true
  echo "worktree-sweep: removed stale temp worktree $phys" >&2
}

# Registered worktrees (the Python pair). porcelain: one block per worktree,
# "worktree <path>" first, an optional "locked" line, blank line between.
path="" locked=0
while IFS= read -r line || [ -n "$line" ]; do
  case $line in
    "worktree "*) path=${line#worktree } locked=0 ;;
    locked*) locked=1 ;;
    "")
      if [ -n "$path" ] && [ "$locked" -eq 0 ] && [ "${path##*/}" = wt ]; then
        sweep_dir "${path%/*}"
      fi
      path="" locked=0
      ;;
  esac
done < <(git worktree list --porcelain 2>/dev/null; echo)

# Unregistered leftovers (the TypeScript pair exports into a plain directory).
for root in "${roots[@]}"; do
  for d in "$root"/redgreen-ts-* "$root"/mutdiff-ts-*; do
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    sweep_dir "$d"
  done
done

# Last: drop registrations whose directory is already gone.
git worktree prune >/dev/null 2>&1 || true
exit 0
