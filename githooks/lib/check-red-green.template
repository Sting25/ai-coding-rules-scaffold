#!/usr/bin/env python3
"""
.githooks/lib/check-red-green — every new test must be shown failing before it
is allowed to pass.

THE PROBLEM THIS SOLVES. "Claude wrote 400 tests and they all pass" carries
almost no information, because a suite generated against an implementation
passes by construction. This is measured, not folklore: LLM test-generation
tools DISCARD any generated test that fails against the current code, so a test
that correctly detects a bug is thrown away for being "wrong". Share of
generated tests that VALIDATE the bug rather than catch it: CoverAgent 59.6%,
CoverUp 68.1% (arXiv 2412.14137); CoverAgent discarded 470 bug-revealing tests,
CoverUp 400. LLM test oracles also follow the implementation, not the intent:
assertion correctness dropped 8-9 points on buggy code (arXiv 2410.21136).

A test never seen to fail has never been shown to test anything.

THE MECHANISM, and why it is not "commit the test first".
Commit ordering is unenforceable and easy to fake — a test committed first can
still be written against an implementation the agent already has in context.
This checks the property that actually matters, which needs no discipline at all:

    take the NEW tests, run them against the OLD code, and require every one
    to fail.

If a new test passes against the base branch, one of three things is true:
  - it tests behaviour that already worked, so it is not evidence for this PR
  - it asserts nothing (the assertion-free test a coverage gate rewards)
  - it was written to match the implementation, not the requirement
All three are worth stopping, with no diff-reading needed.

A test that fails on base because its import does not exist yet counts as RED
(honest: the code it tests did not exist).

THE LEGITIMATE EXCEPTION, made explicit rather than assumed.
Some new tests SHOULD pass against base: characterization tests pinning
behaviour before a refactor, and coverage backfill for correct but untested
code. Both are green-on-base by definition; allowed only when SAID OUT LOUD:

    @pytest.mark.characterization(reason="pinning invoice rounding before refactor")

The marker must carry a reason. An exception you have to name is a decision; an
exception the tool infers is a hole. Register it in pytest.ini alongside the
scaffold's --strict-markers:

    markers =
        characterization: passes against the base branch by design; give a reason

USAGE
  check-red-green --base <ref> [--ci] [--strict-unevaluable] [--max-new N]

A second exemption needs no marker: a test that was MOVED (file split, with or
without reformatting) is not new behaviour, only a new address. It is exempt
when the original node ID is gone from HEAD, the function and enclosing class
are the same AST, and every module-level name it uses or requests (fixtures
named by string too), followed transitively through the module's own bindings,
is bound identically in both files. A copy, a new parametrize case, a changed
helper, fixture or sibling method, a class split across files and a module with
a star import or a fixture name= that is not a string literal are not exempt.
NOT compared: fixtures and helpers outside the module (conftest), autouse
fixtures, setup_* hooks, pytestmark, a fixture registered by calling
pytest.fixture outside a decorator (fx = pytest.fixture(name="val"),
pytest.fixture(**kw)), and module-level statements binding no name the test
reaches. See exempt_as_unchanged_test(); fails closed.

Exit: 0 all new tests were red on base (or explicitly exempt)
      1 one or more new tests passed on base, or tests changed but 0 collected
      2 could not evaluate (no base, collection broken, git failure)

Exit 2 is a FAILURE, not a skip: a check that cannot run never reports green.
Every other end goes through gate-status. NOT overridable via .scaffold.toml.
"""

from __future__ import annotations

import argparse
import ast
import copy
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

TEST_DIR_RE = re.compile(r"(^|/)(tests?|testing)(/|$)")


def run(cmd: list[str], cwd: str | None = None, timeout: int = 900):
    return subprocess.run(
        cmd, cwd=cwd, capture_output=True, text=True, check=False, timeout=timeout
    )


def gate(status: str, n: int, reason: str, rc: int = 0) -> int:
    helper = pathlib.Path(__file__).resolve().parent / "gate-status"
    try:
        return subprocess.call([str(helper), "red-green", status, str(n), reason, str(rc)])
    except OSError as e:  # not executable / missing: exit 2, never a traceback's 1
        print(f"::error::gate-status unusable: {e}")
        return 2


def emit(sev: str, msg: str, ci: bool) -> None:
    if ci:
        print(f"::{sev}::{msg}")
    else:
        print(f"  {sev}: {msg}", file=sys.stderr)


def collect(cwd: str) -> set[str] | None:
    """Collected node IDs, or None if collection failed."""
    r = run([sys.executable, "-m", "pytest", "-q", "--collect-only", "-p", "no:randomly"],
            cwd=cwd)
    if r.returncode not in (0, 5):
        return None
    return {ln.strip() for ln in r.stdout.splitlines() if "::" in ln}


NOISE_RE = re.compile(r"(^|/)(__pycache__|\.pytest_cache|node_modules)(/|$)|\.pyc$")


def is_real_source(p: str) -> bool:
    """Filter build artefacts a careless `git add -A` can commit: a tracked .pyc
    in the diff makes the overlay checkout fail, turning the check into exit 2."""
    return not NOISE_RE.search(p)


def is_test_path(p: str) -> bool:
    name = pathlib.PurePosixPath(p).name
    return bool(TEST_DIR_RE.search(p)) or name.startswith("test_") or name.endswith("_test.py")


def _clean(node):
    """Deep copy without docstrings and Constant.kind (a u'' prefix)."""
    n = copy.deepcopy(node)
    for x in ast.walk(n):
        if isinstance(x, ast.Constant):
            x.kind = None
        b = getattr(x, "body", None)
        if (isinstance(x, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
                and b and isinstance(b[0], ast.Expr)
                and isinstance(b[0].value, ast.Constant)
                and isinstance(b[0].value.value, str)):
            x.body = b[1:] or [ast.Pass()]
    return n


_FN = (ast.FunctionDef, ast.AsyncFunctionDef)
_TREES: dict = {}


def _tree(sha: str, path: str):
    """Parsed module at sha:path, or None if unreadable, not UTF-8 or unparsable
    (cached, failures included)."""
    if (sha, path) not in _TREES:
        t = None
        try:
            r = subprocess.run(["git", "show", f"{sha}:{path}"],
                               capture_output=True, check=False, timeout=900)
            if r.returncode == 0:
                t = ast.parse(r.stdout.decode("utf-8"))
        except (SyntaxError, ValueError, RecursionError):  # incl. UnicodeDecodeError
            t = None
        _TREES[(sha, path)] = t
    return _TREES[(sha, path)]


def _locate(tree, parts):
    """(enclosing ClassDef | None, function) for ['name'] or ['Class', 'name']."""
    top, cls = tree.body, None
    if len(parts) == 2:
        c = [n for n in top if isinstance(n, ast.ClassDef) and n.name == parts[0]]
        if not c:
            return None
        cls, top = c[-1], c[-1].body
    fns = [n for n in top if isinstance(n, _FN) and n.name == parts[-1]]
    return (cls, fns[-1]) if fns and len(parts) <= 2 else None


def _key(cls, fn):
    return (ast.dump(_clean(cls)) if cls else None, ast.dump(_clean(fn)))


def _names(node: ast.AST) -> set:
    """Every Name id, arg name and identifier-like str constant under `node`."""
    return {getattr(x, "id", None) or getattr(x, "arg", None) or x.value
            for x in ast.walk(node) if isinstance(x, (ast.Name, ast.arg))
            or (isinstance(x, ast.Constant) and isinstance(x.value, str)
                and x.value.isidentifier())}


def _free_names(cls, fn) -> set:
    """Names the test reads from module scope (see _names, so fixtures named by
    string count): all in its decorators, parameters, annotations and whole
    enclosing class, plus those in its body that are not its own locals."""
    outer = [*fn.decorator_list, fn.args, fn.returns, cls]  # args: defaults, annotations
    free = set().union(*(_names(o) for o in outer if o))
    loads, local = set(), set()
    for s in fn.body:
        for x in ast.walk(s):
            if isinstance(x, ast.Name):
                (loads if isinstance(x.ctx, ast.Load) else local).add(x.id)
            elif isinstance(x, ast.Constant) and isinstance(x.value, str):
                free |= {x.value} if x.value.isidentifier() else set()
            elif isinstance(x, (*_FN, ast.ClassDef)):
                local.add(x.name)
            elif isinstance(x, ast.ExceptHandler) and x.name:
                local.add(x.name)
            elif isinstance(x, (ast.Import, ast.ImportFrom)):
                local.update((al.asname or al.name).split(".")[0] for al in x.names)
    return free | (loads - local)


def _bindings(tree):
    """({name: [dump of each binding]}, has `from x import *`, {name: [stmts]})."""
    out, nodes, star = {}, {}, False
    for s in tree.body:
        d = ast.dump(_clean(s))
        for x in ([s] if isinstance(s, (*_FN, ast.ClassDef)) else ast.walk(s)):
            if isinstance(x, (ast.Import, ast.ImportFrom)):
                for al in x.names:
                    star = star or al.name == "*"
                    one = copy.copy(x)
                    one.names = [al]
                    k = (al.asname or al.name).split(".")[0]
                    out.setdefault(k, []).append(ast.dump(one) if x is s else d)
                    nodes.setdefault(k, []).append(s)
            elif isinstance(x, (*_FN, ast.ClassDef)):
                nm = [w.value for c in x.decorator_list for w in ast.walk(c)
                      if isinstance(w, ast.keyword) and w.arg == "name"]
                lit = [v.value for v in nm if isinstance(getattr(v, "value", 0), str)]
                star = star or len(lit) < len(nm)  # opaque name=
                for k in [x.name, *lit]:
                    out.setdefault(k, []).append(d)
                    nodes.setdefault(k, []).append(s)
            elif isinstance(x, ast.Name) and isinstance(x.ctx, ast.Store):
                out.setdefault(x.id, []).append(d)
                nodes.setdefault(x.id, []).append(s)
    return out, star, nodes


def exempt_as_unchanged_test(nid: str, head_sha: str, base_sha: str,
                             head_ids: set, base_ids: set) -> bool:
    """True when a new, green-on-base node ID is a TRUE MOVE of an existing test:

      1. a base node ID with the same `[Class::]name[param]` tail existed (so a
         new parametrize case in place is new, and so is a renamed test),
      2. that base node ID is no longer collected at HEAD (a copy is not a move),
      3. the test's function and enclosing class are the same AST (docstrings
         and u'' prefixes stripped; wrapping, quoting and commas do not matter),
      4. every module-level name the test uses or requests as a parameter
         (imports, assignments, defs, classes, fixtures) is bound identically
         in both files, or unbound in both. Names are followed transitively
         through the module's own bindings; fixtures named by string count,
      5. neither module has a `from x import *` or a non-literal fixture name=.

    Pure AST comparison, nothing is imported or run. NOT compared: fixtures and
    helpers outside the module (conftest), autouse fixtures, setup_* hooks,
    pytestmark, fixtures built by calling pytest.fixture outside a decorator, and
    module-level statements binding no name the test reaches. Fails closed: an
    unreadable HEAD file, a node not found, or a timeout returns False; an
    unreadable or unparsable BASE file is skipped (it only removes candidates).
    """
    try:
        path, *rest = nid.split("::")
        if not rest or len(rest) > 2:
            return False
        tail = "::".join(rest)
        ht = _tree(head_sha, path)
        hloc = ht and _locate(ht, [re.sub(r"\[.*\]$", "", x) for x in rest])
        if not hloc:
            return False
        hkey, hnames, (hbind, hstar, hnodes) = _key(*hloc), _free_names(*hloc), _bindings(ht)
        todo = set(hnames)
        while todo:
            for st in hnodes.get(todo.pop(), []):
                new = _names(st)
                todo |= new - hnames
                hnames |= new
        for b in sorted(base_ids):
            bpath, _, btail = b.partition("::")
            bt = None if btail != tail or b in head_ids else _tree(base_sha, bpath)
            bloc = bt and _locate(bt, [re.sub(r"\[.*\]$", "", x) for x in rest])
            if not bloc or _key(*bloc) != hkey:
                continue
            bbind, bstar, _ = _bindings(bt)
            if not (hstar or bstar) and all(hbind.get(n) == bbind.get(n) for n in hnames):
                return True
        return False
    except (SyntaxError, ValueError, RecursionError, subprocess.TimeoutExpired):
        return False


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--base", required=True, help="base ref to compare against")
    ap.add_argument("--ci", action="store_true")
    ap.add_argument("--strict-unevaluable", action="store_true",
                    help="fail when a new test cannot be executed against base at all")
    ap.add_argument("--max-new", type=int, default=200,
                    help="refuse to re-run more than this many new tests (guards CI time)")
    args = ap.parse_args()

    base = run(["git", "rev-parse", "--verify", f"{args.base}^{{commit}}"])
    if base.returncode != 0:
        emit("error", f"cannot resolve base ref {args.base!r}. In CI make sure the "
                      "checkout has fetch-depth: 0.", args.ci)
        return 2
    base_sha = base.stdout.strip()

    head = run(["git", "rev-parse", "--verify", "HEAD"])
    if head.returncode != 0:
        emit("error", "cannot resolve HEAD.", args.ci)
        return 2
    head_sha = head.stdout.strip()
    # head_sha, never the literal "HEAD": inside a linked worktree "HEAD" is the
    # base commit, so `git checkout HEAD -- tests/` there restores the BASE tests,
    # pytest exits 4, "failed on base" reads as red and the check reports a false
    # green on the case it exists to catch (hence the explicit exit-4 guard).

    d = run(["git", "diff", "--name-only", "--diff-filter=d", f"{base_sha}...HEAD"])
    if d.returncode != 0:
        emit("error", f"git diff {base_sha!r}...HEAD failed: {d.stderr.strip()}", args.ci)
        return 2
    changed = d.stdout.split()
    test_paths = [p for p in changed if is_test_path(p) and is_real_source(p)]
    if not test_paths:
        return gate("empty", 0, "no test files changed in this diff")
    if not any(p.endswith(".py") for p in test_paths):
        return gate("empty", 0, "no changed .py test files")

    here = collect(".")
    if here is None:
        emit("error", "pytest collection failed on HEAD, so new tests cannot be "
                      "identified. Fix collection first.", args.ci)
        return 2
    if not here:
        return gate("ran", 0, f"{len(test_paths)} test file(s) changed, pytest collected 0")

    tmp = tempfile.mkdtemp(prefix="redgreen-")
    wt = os.path.join(tmp, "wt")
    try:
        run(["git", "worktree", "prune"])  # best-effort; drops every stale entry, locked ones stay
        r = run(["git", "worktree", "add", "--detach", wt, base_sha])
        if r.returncode != 0:
            emit("error", f"git worktree add failed: {r.stderr.strip()}", args.ci)
            return 2

        # STEP 1 — collect the PRISTINE base, before any overlay: it defines
        # "new" (present at HEAD, absent here). After the overlay the new tests
        # would collect too (and just fail), making the difference empty.
        base_pristine = collect(wt)
        if base_pristine is None:
            emit("error", "pytest collection failed on the base commit itself. "
                          "The base is broken, so nothing can be measured "
                          "against it.", args.ci)
            return 2

        new_ids = sorted(here - base_pristine)
        if not new_ids:
            return gate("empty", 0, f"no new test node IDs ({len(here)} collected)")

        if len(new_ids) > args.max_new:
            emit("warning",
                 f"{len(new_ids)} new tests exceeds --max-new={args.max_new}; "
                 "re-running that many against base would dominate CI time. "
                 "Split the PR: that many tests at once is not reviewable.", args.ci)
            return 1

        # STEP 2 — overlay HEAD's test files onto the base source tree.
        r = run(["git", "checkout", head_sha, "--", *test_paths], cwd=wt)
        if r.returncode != 0:
            emit("error", f"could not overlay test files onto base: "
                          f"{r.stderr.strip()}", args.ci)
            return 2

        # Config that governs collection must also come from HEAD, or a new test
        # in a new directory is simply not collected and silently reports green.
        for cfg in ("pytest.ini", "pyproject.toml", "tox.ini", "setup.cfg"):
            if pathlib.Path(cfg).exists():
                run(["git", "checkout", head_sha, "--", cfg], cwd=wt)

        # STEP 3 — classify each new test individually against base source.
        #
        # Per node ID, not one aggregate run, because the aggregate collapses a
        # mixed result. pytest exit codes here mean:
        #   0  passed on base            -> OFFENDER (or exempt, checked below)
        #   1  failed on base            -> RED, which is what we want
        #   4  could not run it at all   -> UNEVALUABLE, see below
        #
        # THE HONEST LIMIT OF THIS CHECK. When a new test module imports a symbol
        # that does not exist on base (`from calc import div`), the import fails
        # and pytest returns 4 for EVERY test in that file — including any that
        # would have passed. There is no way to tell them apart from outside,
        # because on base they cannot be executed at all.
        #
        # A genuine gap, stated rather than papered over: a test for pre-existing
        # behaviour in a file that also imports new code is invisible here. It
        # is reported by file and count so the CI log shows it, and
        # --strict-unevaluable turns it into a failure. The assertion ratchet in
        # check-test-ratchet and the characterization marker are partial
        # answers; mutation testing on the diff is the real one.
        offenders: list[str] = []
        red: list[str] = []
        unevaluable: dict[str, int] = {}

        for nid in new_ids:
            ri = run(
                [sys.executable, "-m", "pytest", "-q", "-p", "no:randomly",
                 "--no-header", "-rN", nid],
                cwd=wt,
            )
            if ri.returncode == 0:
                offenders.append(nid)
            elif ri.returncode == 1:
                red.append(nid)
            else:
                f = nid.split("::", 1)[0]
                unevaluable[f] = unevaluable.get(f, 0) + 1

        # ── Exempt the ones that say out loud that they pass on base ──────────
        exempt = []
        unchanged = []
        still_offending = []
        for nid in offenders:
            rk = run(
                [sys.executable, "-m", "pytest", "-q", "--collect-only",
                 "-m", "characterization", "--no-header", nid],
            )
            if rk.returncode == 0 and "::" in rk.stdout:
                exempt.append(nid)
            elif exempt_as_unchanged_test(nid, head_sha, base_sha, here,
                                          base_pristine):
                unchanged.append(nid)
            else:
                still_offending.append(nid)

        for nid in exempt:
            print(f"  exempt (characterization): {nid}")
        for nid in unchanged:
            print(f"  exempt (moved, body and context unchanged): {nid}")
        if red:
            print(f"  red on base, as required: {len(red)} test(s)")

        failed = False

        if unevaluable:
            total = sum(unevaluable.values())
            msg = (f"{total} new test(s) could not be executed against base "
                   "because their module does not import there — normally "
                   "because they reference code this PR adds. Counted as red. "
                   "This check cannot see inside such a file, so a test for "
                   "pre-existing behaviour placed in one is not verified: "
                   + ", ".join(f"{f} ({n})" for f, n in sorted(unevaluable.items())))
            if args.strict_unevaluable:
                emit("error", msg + " — failing because --strict-unevaluable is "
                                    "set. Split tests for existing behaviour into "
                                    "a file that imports only existing code.",
                     args.ci)
                failed = True
            else:
                emit("notice", msg, args.ci)

        if still_offending:
            emit("error",
                 f"{len(still_offending)} new test(s) PASS against "
                 f"{args.base[:12]}. A test that passes without the change it "
                 "accompanies is not evidence that the change works — it tests "
                 "behaviour that already existed, or it asserts nothing. Make "
                 "each one fail on base first, or mark it "
                 "@pytest.mark.characterization(reason=...) if it is "
                 "deliberately pinning existing behaviour.", args.ci)
            for nid in still_offending:
                emit("error", f"green-on-base: {nid}", args.ci)
            failed = True

        if not failed:
            print(f"red-green OK: {len(new_ids)} new test(s) accounted for "
                  f"({len(red)} red, {len(exempt)} characterization, "
                  f"{len(unchanged)} moved-unchanged, "
                  f"{sum(unevaluable.values())} unevaluable).")
        return gate("ran", len(new_ids), "", 1 if failed else 0)

    finally:
        run(["git", "worktree", "remove", "--force", wt])
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    try:
        _RL = pathlib.Path(__file__).with_name("refusal-log"); _B = shutil.which("bash"); rc = main(); sys.stdout.flush(); rc and _B and _RL.is_file() and subprocess.run([_B, str(_RL), "check-red-green", {1: "green-on-base-or-cap", 2: "setup-error"}.get(rc, "error"), "", str(rc), "--say", {1: "a"}.get(rc, "b")], check=False); raise SystemExit(rc)
    except subprocess.TimeoutExpired:
        print("::error::red-green check timed out. A suite too slow to run twice "
              "is a suite too slow to trust as a gate; split it or scope this "
              "check to a subset.")
        sys.stdout.flush(); _B and _RL.is_file() and subprocess.run([_B, str(_RL), "check-red-green", "timeout", "", "2", "--say", "b"], check=False); raise SystemExit(2)
