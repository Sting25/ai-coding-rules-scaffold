#!/usr/bin/env bash
# Pre-commit hook orchestrator: calls the check scripts in lib/.
# Each lib/check-* script is independently runnable; the CI workflow
# invokes the same scripts so the hook and CI can never drift.
#
# Install (from project root) — install.sh handles all of this:
#   .githooks/pre-commit
#   .githooks/lib/{check-size,check-large-files,check-patterns,check-filenames,check-secrets}
#   git config core.hooksPath .githooks
#
# Patterns are read from:
#   .forbidden-patterns/backend.txt   (regex<TAB>description; *.py)
#   .forbidden-patterns/frontend.txt  (regex<TAB>description; *.ts,*.tsx,*.js,*.jsx)
#   .forbidden-patterns/shell.txt     (regex<TAB>description; *.sh,*.bash)
#   .forbidden-patterns/secrets.txt   (regex<TAB>description; all text files)
#
# Lines starting with # in those files are comments.
#
# The lib/check-* scripts scan the STAGED BLOB (`git show ":0:<path>"`), not the
# working tree, so symlinks, embedded NUL bytes, and post-stage working-tree
# edits cannot hide content from the scan.

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$HOOK_DIR/lib"

# Enumerate staged files NUL-delimited (-z) so a filename containing a newline,
# tab, or quote can't split the list and slip a file past every scanner. A
# shell variable cannot hold NUL bytes, so the list goes to a temp file and each
# check is fed from it. (core.quotepath is irrelevant under -z, which never
# C-quotes; kept only for defence in depth.)
# Refuse to let a commit silently disable the scanners by deleting their config.
# A staged deletion of a .forbidden-patterns/*.txt that also removes the file
# from disk makes the matching check find no config and exit 0 — a one-commit
# way to land a secret AND neuter the scan. A staged deletion whose file is
# still on disk (`git rm --cached`) is a different thing and only warns for the
# two configs CI re-arms itself; see the untrack-vs-delete note below.
# Checked BEFORE the empty-staged-list exit, since a delete-only commit has an
# empty ACMR list. Use `git commit --no-verify` if a removal is intended (uninstall).
# `--no-renames` is load-bearing: git's default rename detection reports a
# `git mv secrets.txt secrets.txt.disabled` as an R (rename), not a D, so the
# guard's list would be empty and the neutered-config commit would pass. Treating
# a rename as delete+add surfaces the OLD path as a D so the guard still fires.
DELETED_CONFIG=$(git diff --cached --no-renames -z --name-only --diff-filter=D | tr '\0' '\n' | grep -E '^\.forbidden-patterns/.+\.txt$' || true)
if [ -n "$DELETED_CONFIG" ]; then
  # UNTRACKING is not DISABLING. `git rm --cached` stages a deletion but leaves
  # the file on disk — the local-only-tooling pattern, paired with an entry in
  # .git/info/exclude. Every check reads its pattern config from the WORKING
  # TREE, never from the index: check-secrets does `done <"$CONFIG"`,
  # check-patterns iterates `.forbidden-patterns/*.txt`, agent-precheck reads
  # `$pfile`. (`git show ":0:"` appears in those scripts only for the CONTENT
  # being scanned, never for the config.) So a file still on disk keeps the
  # scanner fully armed for this and every later local commit.
  #
  # This does not reopen the neutering paths closed by 5ced87a / 3ef4ad9: those
  # cover a config that is GONE, gutted to zero patterns, or renamed away, and
  # all three still fail.
  #
  # But local-only leniency is sound ONLY where the server-side scan refuses to
  # run without the config, because an untracked config is absent from CI's
  # checkout and from every fresh clone. That holds for exactly two files:
  #   secrets.txt — check-secrets exits 1 on a missing config in --ci mode.
  #   shell.txt   — check-patterns now does the same, on the same reasoning:
  #                 install.sh writes secrets.txt and shell.txt in EVERY mode, so
  #                 their absence server-side can only mean "removed after
  #                 install".
  # For every other .forbidden-patterns/*.txt it is FALSE. backend/frontend/
  # <lang>.txt are installed conditionally, so check-patterns cannot tell a
  # removed config from a language this project never had and must stay silent —
  # untracking one disables its rules for every clone AND for CI with nothing
  # anywhere reporting it. The old blanket note ("CI ... fails closed there") was
  # verified against check-secrets only and was wrong for those files. This hook
  # is the only gate that can see the removal at all, so for them it refuses.
  #
  # Treat unreadable or non-regular as gone: the checks cannot read it either.
  GONE_CONFIG=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ ! -f "$f" ] || [ ! -r "$f" ]; then
      GONE_CONFIG="$GONE_CONFIG$f"$'\n'
    fi
  done <<EOF_DELCFG
$DELETED_CONFIG
EOF_DELCFG
  if [ -n "$GONE_CONFIG" ]; then
    echo "error: this commit deletes forbidden-pattern config, disabling the scanner:" >&2
    printf '%s' "$GONE_CONFIG" | sed 's/^/       /' >&2
    echo "       Refusing — re-add it, or use 'git commit --no-verify' if intended." >&2
    exit 1
  fi
  # Split the untracked configs by whether the CI scanner fails closed on their
  # absence (see the note above): the two always-installed ones warn, the rest
  # refuse.
  LENIENT_CONFIG=""
  STRICT_CONFIG=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "${f##*/}" in
      secrets.txt|shell.txt) LENIENT_CONFIG="$LENIENT_CONFIG$f"$'\n' ;;
      *)                     STRICT_CONFIG="$STRICT_CONFIG$f"$'\n' ;;
    esac
  done <<EOF_UNTRACKED
$DELETED_CONFIG
EOF_UNTRACKED
  if [ -n "$STRICT_CONFIG" ]; then
    echo "error: this commit untracks forbidden-pattern config that nothing enforces server-side — check-patterns cannot tell a removed optional config from a language this project never installed, so these rules stop running in every fresh clone and in CI:" >&2
    printf '%s' "$STRICT_CONFIG" | sed 's/^/       /' >&2
    echo "       Refusing — re-add it, or use 'git commit --no-verify' if intended." >&2
    exit 1
  fi
  echo "note: forbidden-pattern config untracked but still present on disk — local scanning stays active:" >&2
  printf '%s' "$LENIENT_CONFIG" | sed 's/^/       /' >&2
  echo "       CI has no copy of an untracked config, and check-secrets/check-patterns fail closed on a missing secrets.txt/shell.txt, so a guardrails job fails closed there." >&2
fi

STAGED_LIST=$(mktemp)
git -c core.quotepath=off diff --cached -z --name-only --diff-filter=ACMR >"$STAGED_LIST"
if [ ! -s "$STAGED_LIST" ]; then
  rm -f "$STAGED_LIST"
  exit 0
fi

# Make the working tree match the staged content for the duration of the run.
# The guardrail checks read the index blob directly and so do not depend on this
# — but the optional ruff/eslint feedback step below lints working-tree files,
# and stashing keeps it honest. Skipped during merge/rebase, where stash is
# unsafe.
NEED_RESTORE=0
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo .git)
if [ ! -e "$GIT_DIR/MERGE_HEAD" ] && [ ! -e "$GIT_DIR/REBASE_HEAD" ]; then
  if ! git diff --quiet 2>/dev/null; then
    if git stash push --keep-index --quiet --message "pre-commit-hook" 2>/dev/null; then
      NEED_RESTORE=1
    else
      echo "error: pre-commit hook could not stash unstaged changes." >&2
      echo "       Refusing to proceed — commit or stash your changes manually first." >&2
      rm -f "$STAGED_LIST"
      exit 1
    fi
  fi
fi

# shellcheck disable=SC2317,SC2329  # invoked via the EXIT trap below
cleanup() {
  if [ "$NEED_RESTORE" -eq 1 ]; then
    # Do NOT silently swallow a failed pop: on a conflicted restore the user's
    # unstaged work is stranded in the stash, and `|| true` would hide that.
    if ! git stash pop --quiet 2>/dev/null; then
      echo "" >&2
      echo "error: pre-commit could not automatically restore your unstaged changes." >&2
      echo "       They are SAFE in the stash. Recover with:" >&2
      echo "         git stash list      # find the 'pre-commit-hook' entry" >&2
      echo "         git stash pop       # resolve conflicts, or:" >&2
      echo "         git checkout stash@{0} -- <file>" >&2
    fi
  fi
  rm -f "$STAGED_LIST"
}
trap cleanup EXIT

FAILED=0
"$LIB/check-size"        <"$STAGED_LIST" || FAILED=1
"$LIB/check-large-files" <"$STAGED_LIST" || FAILED=1
"$LIB/check-patterns"    <"$STAGED_LIST" || FAILED=1
"$LIB/check-filenames"   <"$STAGED_LIST" || FAILED=1
"$LIB/check-secrets"     <"$STAGED_LIST" || FAILED=1
"$LIB/check-hygiene"     <"$STAGED_LIST" || FAILED=1
# Opt-in only: present iff installed with `install.sh --gitleaks-hook`. The
# existence guard is the opt-in switch — a project that didn't opt in has no
# such file and skips it entirely.
if [ -x "$LIB/check-gitleaks" ]; then
  "$LIB/check-gitleaks" <"$STAGED_LIST" || FAILED=1
fi

# Project-local checks — the supported extension point (issue #72). Every
# executable in .githooks/local.d/ runs here under the SAME contract as the
# shipped checks: the NUL-delimited staged list on stdin, non-zero exit blocks
# the commit. `.github/workflows/lint.yml` runs the same directory server-side.
#
# This exists so a project never has to edit THIS file to wire a check in.
# pre-commit and lint.yml are scaffold-owned and refreshed by install.sh, so a
# call site added here is reset on upgrade while the check script it called
# stays on disk — the check silently becomes decoration. install.sh never
# writes into local.d/, so an upgrade cannot unwire anything in it.
#
# `-f` before `-x` because an unmatched glob expands to the literal pattern
# under bash's default (no nullglob), and the executable bit is the on/off
# switch — a plain README in there is inert. Spelled as an `if`, not
# `[ -f ] && [ -x ] || continue`: that form is correct here but trips SC2015,
# and the scaffold fixes the file rather than suppressing the check. Keep going
# after a failure so one run reports every problem, like the shipped checks.
if [ -d "$HOOK_DIR/local.d" ]; then
  for lc in "$HOOK_DIR"/local.d/*; do
    if [ ! -f "$lc" ] || [ ! -x "$lc" ]; then
      continue
    fi
    "$lc" <"$STAGED_LIST" || FAILED=1
  done
fi

# Lint staged files with ruff / eslint when configs exist and the tool is
# installed. CI is the source of truth: running here just shortens the
# feedback loop. When matching files are staged but the tool isn't on PATH,
# each check below prints a one-line notice to stderr and skips (exit stays
# 0), so the hook stays usable on machines that haven't run `pip install
# ruff` yet while still telling the developer why nothing ran.
# "Installed" for a JS tool means resolvable from THIS project's node_modules
# (walking upward, so hoisted monorepos count). `npx --no-install <tool>` is
# not that test: it also answers from npm's global _npx cache (measured: an
# empty directory reports eslint 10.9.1 when ~/.npm/_npx holds one). A cached
# tool then runs against this project's config with none of the config's own
# imports installed, crashes, and fails the commit for a tool the project never
# asked for. Node's resolver never consults that cache, so it is the gate; npx
# only launches the binary once the gate passes.
js_tool_installed() {
  if command -v node >/dev/null 2>&1 && command -v npx >/dev/null 2>&1 \
     && node -e "require.resolve('$1/package.json')" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

STAGED_PY=()
STAGED_JS=()
STAGED_PHP=()
while IFS= read -r -d '' f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.py)                  STAGED_PY+=("$f") ;;
    *.ts|*.tsx|*.js|*.jsx|*.vue) STAGED_JS+=("$f") ;;
    *.php|*.phtml)         STAGED_PHP+=("$f") ;;
  esac
done <"$STAGED_LIST"

# Config detection mirrors `lint.yml`'s `hashFiles(...)` predicate so the
# hook fires in the same projects where CI does.
if [ ${#STAGED_PY[@]} -gt 0 ] && { [ -f ruff.toml ] || [ -f pyproject.toml ]; }; then
  if command -v ruff >/dev/null 2>&1; then
    ruff check -- "${STAGED_PY[@]}" || FAILED=1
  else
    echo "note: ruff not installed, skipping the local lint pass on staged .py files." >&2
    echo "      CI's lint job is the authoritative gate; install ruff for local feedback." >&2
  fi
fi

if [ ${#STAGED_JS[@]} -gt 0 ] && { [ -f eslint.config.js ] || [ -f package.json ]; }; then
  if js_tool_installed eslint; then
    npx --no-install eslint -- "${STAGED_JS[@]}" || FAILED=1
  else
    echo "note: eslint not installed in this project's node_modules, skipping the local lint pass on staged JS/TS files." >&2
    echo "      CI's lint job is the authoritative gate; run 'npm install' for local feedback." >&2
  fi
fi

# Prettier formats; eslint checks correctness: they don't overlap (the eslint
# config ships no stylistic rules, so there's no eslint-config-prettier). Run
# --check on staged files when a prettier config exists and prettier is
# installed. A missing/unresolvable prettier prints a notice and skips, like
# the linter above. `prettier --write` is the fix.
if [ ${#STAGED_JS[@]} -gt 0 ] \
   && { [ -f .prettierrc ] || [ -f .prettierrc.json ] || [ -f .prettierrc.js ] || [ -f prettier.config.js ] || grep -qs '"prettier"' package.json; }; then
  if js_tool_installed prettier; then
    npx --no-install prettier --check -- "${STAGED_JS[@]}" || FAILED=1
  else
    echo "note: prettier not installed in this project's node_modules, skipping the local format check on staged JS/TS files." >&2
    echo "      CI's lint job is the authoritative gate; run 'npm install' for local feedback." >&2
  fi
fi

# Type-check with tsc when a tsconfig.json exists and TypeScript is installed.
# Run PROJECT-WIDE (no file args): passing individual files makes tsc ignore
# tsconfig.json and its compiler options. A missing/unresolvable tsc prints a
# notice and skips, like the checks above; CI is the authoritative backstop.
if [ ${#STAGED_JS[@]} -gt 0 ] && [ -f tsconfig.json ]; then
  if js_tool_installed typescript; then
    npx --no-install tsc --noEmit || FAILED=1
  else
    echo "note: TypeScript not installed in this project's node_modules, skipping the local tsc type check." >&2
    echo "      CI's lint job is the authoritative gate; run 'npm install' for local feedback." >&2
  fi
fi

# PHP: zero-config syntax check (`php -l`) on each staged file when php is on
# PATH, plus phpcs when a ruleset/composer project is present and phpcs is
# installed. A missing php/phpcs prints a notice and skips, like the checks
# above.
if [ ${#STAGED_PHP[@]} -gt 0 ]; then
  if command -v php >/dev/null 2>&1; then
    for f in "${STAGED_PHP[@]}"; do
      php -l "$f" >/dev/null 2>&1 || { echo "✗ $f: PHP syntax error (php -l)"; FAILED=1; }
    done
  else
    echo "note: php not installed, skipping the local syntax check (php -l) on staged PHP files." >&2
    echo "      CI's lint job is the authoritative gate; install php for local feedback." >&2
  fi
fi
if [ ${#STAGED_PHP[@]} -gt 0 ] && { [ -f phpcs.xml ] || [ -f phpcs.xml.dist ] || [ -f composer.json ]; }; then
  if command -v phpcs >/dev/null 2>&1; then
    phpcs -- "${STAGED_PHP[@]}" || FAILED=1
  else
    echo "note: phpcs not installed, skipping the local coding-standard check on staged PHP files." >&2
    echo "      CI's lint job is the authoritative gate; install phpcs for local feedback." >&2
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "Pre-commit failed. Fix the issues above or use 'git commit --no-verify' to skip (don't)."
  exit 1
fi

exit 0
