// Copy to project root as `vitest.config.ts` (install.sh does this for frontend
// stacks unless the project already uses Jest). Vitest is the default runner:
// Vite-native, ESM-first, near-zero config. Swap for Jest if your stack already
// standardized on it — the scaffold won't fight an existing choice.
//
// A test runner does NOT force tests to exist or to assert anything. The
// opt-in patch-coverage gate (`.github/workflows/coverage.yml`,
// `install.sh --coverage-gate`) is what makes the build fail when CHANGED lines
// ship untested — and even that forces lines to be EXECUTED by a test, not
// verified by one. See RECOMMENDATIONS.md ("forcing tests") for the ceiling.
import { coverageConfigDefaults, defineConfig } from 'vitest/config';

export default defineConfig({
  test: {
    // Glob mirrors the eslint test-file override (which covers the ts/tsx half
    // of this list) so the same files are "tests" to both tools. The other
    // extensions are here because a `.test.js` that vitest never COLLECTS is a
    // test that never runs — and its subject then reaches the coverage gate
    // unmeasured. mts/cts included for the same reason: `coverage.include`
    // below counts them as source, so a `.test.mts` that is neither collected
    // NOR measured is the worst of both.
    include: ['**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs,mts,cts}'],
    coverage: {
      // V8 is built in (no extra dep). `json` + `cobertura` reporters feed the
      // patch-coverage gate; `text` prints a summary locally.
      provider: 'v8',
      reporter: ['text', 'json', 'cobertura'],
      reportsDirectory: 'coverage',
      // ⚠ A WRONG `include` HERE IS A SILENT PASS, NOT AN ERROR. diff-cover (the
      // patch-coverage gate in .github/workflows/coverage.yml) scores a changed
      // line it has NO coverage data for as COVERED, so a file this glob misses
      // does not show up at 0% — it vanishes from the report and the gate goes
      // green on wholly untested code. The symptom to look for: a green
      // "patch-coverage" check whose log says "No lines with coverage
      // information in this diff", or a `text` reporter summary that lists far
      // fewer files than your repo has. `coverage.yml`'s blind-spot step fails
      // the job on exactly this, but only for files it can see are missing.
      //
      // Hence whole-tree + `all: true`, deliberately mirroring .coveragerc's
      // `source = .` (the Python half of the same gate): a source file that no
      // test ever imports MUST appear at 0%, not disappear. Narrow this only to
      // exclude things, never to pick a single root — the previous default,
      // 'src/**/*.{ts,tsx}', measured nothing at all on an app/, lib/,
      // packages/* or Next.js layout, and nothing anywhere said so.
      all: true,
      include: ['**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,vue,svelte}'],
      // vitest REPLACES its default exclude list when you set this key — it
      // does not merge — so this SPREADS the defaults rather than respelling
      // them. Hand-writing the list loses about eight entries most people do
      // not remember (`**/[.]**`, `test?(s)/**`, `cypress/**`, `*-test.ts`,
      // `*.bench.ts`, `vitest.workspace.ts`, `.eslintrc.*`, `.prettierrc.*`),
      // and with `all: true` above every one of them is then walked and
      // reported at 0% — which at DIFF_COVER_FAIL_UNDER=100 fails the PR that
      // merely ADDED an .eslintrc.js, on a line no reviewer would ask for a
      // test on. Add to this list; do not replace it. (`coverageConfigDefaults`
      // is exported from `vitest/config` — vitest 1.0 and newer.)
      //
      // ⚠ Anything you add here vanishes from cobertura-coverage.xml, and
      // diff-cover scores a changed line it has no data for as COVERED — so an
      // entry naming a directory of your own SOURCE is an off switch for the
      // gate, exactly like .coveragerc's `omit`. scaffold-doctor.sh reports
      // added entries that are not recognizably test/build/tooling paths.
      exclude: [
        ...coverageConfigDefaults.exclude,
        '**/build/**',
        '**/*.config.*',
      ],
    },
  },
});
