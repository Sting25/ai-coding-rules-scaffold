  #       run: '[ -f Gemfile ] && echo "present=true" >> "$GITHUB_OUTPUT" || true'
  #     - if: steps.detect.outputs.present == 'true'
  #       uses: ruby/setup-ruby@12fd324f1d0b43274fdc8130f6980590a667c455  # v1.312.0
  #       with:
  #         ruby-version: "3.3"
  #         bundler-cache: true
  #     - if: steps.detect.outputs.present == 'true'
