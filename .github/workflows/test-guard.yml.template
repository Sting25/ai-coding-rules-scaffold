name: test-guard

# Installed as `.github/workflows/test-guard.yml`.
# Installed by the scaffold's opt-in `--test-guard` flag.
#
# The anti-gaming layer. Every other gate in this scaffold assumes the test
# suite is an honest witness; this workflow checks the witness. It runs two
# checks, each in a Python flavour (pytest, mutmut) and a TypeScript flavour
# (Vitest, Stryker); a project gets whichever of the two it has:
#
#   check-red-green      a NEW test that passes against the base branch was
#                         never observed failing, and is therefore not
#                         evidence that anything was fixed
#
#   check-mutation-diff  a NEW test can pass red-green while still asserting
#                         nothing about the new code's behaviour. This check
#                         mutates the lines the PR changed and reports, per
#                         file, every mutant the suite fails to kill.
#                         It is advisory-first (issue #145): surviving
#                         mutants print a warning but never fail the job.
#                         Exit code 2 (mutmut missing or the wrong pinned
#                         version, a broken baseline suite, a bad worktree
#                         or config, or a timeout) IS a failure and does
#                         fail the job, since that means the check could not
#                         evaluate anything, not that it evaluated cleanly.
#
# INTERPLAY between the two checks. A file check-red-green reports
# "unevaluable" (its imports don't resolve against base, so no test in it
# can be run there at all) is exactly where a vacuous test is most likely to
# hide, since the file was already opaque to red-green. A surviving mutant
# check-mutation-diff finds in that same file is this workflow's single
# highest-signal finding.
#
# A suite generated against an implementation passes by construction. The
# red-green check runs each new test node ID against a scratch worktree of
# the base commit and requires it to fail there. New tests that legitimately
# pass on base (characterization tests pinning behaviour before a refactor,
# coverage backfill for already-correct code) must say so out loud:
#
#     @pytest.mark.characterization(reason="pinning invoice rounding before refactor")
#
# Register the marker in pytest.ini (the installer prints the snippet):
#
#     markers =
#         characterization: passes against the base branch by design; give a reason
#
# WHY IT IS A SEPARATE WORKFLOW from tests.yml / coverage.yml. Those answer
# "does the code work". This answers "is the thing that answers that question
# still intact". They fail for different reasons and want different fixes,
# and collapsing them makes both failure messages worse.
#
# REQUIRED CHECK. This workflow is worth roughly nothing until it is a
# REQUIRED status check on the default branch. An advisory check on a repo
# where the agent can also merge is a check the agent can route around.
#
# Actions are pinned to a commit SHA (trailing comment = version); the SHAs
# match lint.yml / tests.yml / coverage.yml so Dependabot bumps them together.
#
# THE TYPESCRIPT TWIN (check-red-green-ts, check-mutation-diff-ts) mirrors the
# Python pair flag for flag and exit code for exit code. Differences worth
# knowing: a Vitest test that passes on base by design carries a title that
# starts with "characterization: <reason>" (there is no marker mechanism and
# no moved-test exemption), and CI installs the pinned Stryker itself.

on:
  pull_request:

permissions:
  contents: read

jobs:
  test-guard:
    runs-on: ubuntu-latest
    # checks: write is for the neutral "mutation declined" check run only.
    # A job-level block replaces the top-level one, so contents: read repeats.
    permissions:
      contents: read
      checks: write # the neutral "mutation declined" check run only
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          # check-red-green resolves and checks out the PR base commit, so it
          # needs history. Same reason as coverage.yml.
          fetch-depth: 0
          persist-credentials: false  # don't leave GITHUB_TOKEN in .git/config

      - id: detect
        run: |
          if [ -f pyproject.toml ] || [ -f pytest.ini ] || [ -f setup.py ]; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "no Python project detected, skipping the Python test-guard steps"
          fi

      # Same detection as tests.yml: vitest must be DECLARED, not merely a
      # package.json present (#96).
      - id: detect_ts
        run: |
          if [ ! -f package.json ]; then
            echo "no package.json, skipping the TypeScript test-guard steps"
          elif grep -q '"vitest"' package.json \
               || grep -qE '"test"[[:space:]]*:[[:space:]]*"[^"]*vitest' package.json; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "package.json present but vitest is not declared (devDependencies/dependencies/scripts.test), skipping the TypeScript test-guard steps"
          fi

      - if: steps.detect.outputs.present == 'true'
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0  # v7.1.0
        with:
          python-version: "3.12"

      # Same install logic as tests.yml: a check that cannot import the
      # package under test cannot tell "red on base" from "broken everywhere".
      - name: Install project
        if: steps.detect.outputs.present == 'true'
        run: |
          pip install pytest==9.1.1
          if [ -f pyproject.toml ] && grep -q '^\[project\]' pyproject.toml; then
            if grep -q '^\[project.optional-dependencies\]' pyproject.toml && grep -qE '^dev[[:space:]]*=' pyproject.toml; then
              pip install -e ".[dev]"
            else
              pip install -e .
            fi
          elif [ -f setup.py ]; then
            pip install -e .
          fi
          for req in requirements.txt requirements-dev.txt requirements/dev.txt; do
            if [ -f "$req" ]; then
              pip install -r "$req"
            fi
          done

      # The base is derived at run time, not read from the event payload:
      # github.event.pull_request.base.sha is frozen when the PR last changed,
      # but the checkout is a synthetic merge against the base branch's CURRENT
      # tip. Diffing from the stale sha pulls every commit merged since into
      # the scope (#199). merge-base with the base branch's tip is right for
      # both checkouts: on the synthetic merge it is the merge's first parent
      # by construction, and on a PR head (even one that merged the base
      # branch itself) it is where the PR left the base. A "is HEAD^2 set"
      # test cannot tell those two apart, so none is used.
      - name: Resolve base commit
        id: base
        if: steps.detect.outputs.present == 'true' || steps.detect_ts.outputs.present == 'true'
        run: |
          if ! BASE_SHA=$(git merge-base "origin/$GITHUB_BASE_REF" HEAD); then
            echo "::error::cannot resolve origin/$GITHUB_BASE_REF or its merge-base with HEAD. The checkout needs fetch-depth: 0 and the pull request's base branch."
            exit 1
          fi
          echo "sha=$BASE_SHA" >> "$GITHUB_OUTPUT"

      # PR-only by the trigger above: "new relative to the base" has no
      # meaning on a push to main, where the comparison already happened in
      # the PR that produced it.
      #
      # This step re-runs the new tests once more against a scratch worktree
      # of the base commit, so it roughly doubles the cost of the new tests
      # (not of the suite). If that becomes the slowest thing in CI, that is
      # a signal about test speed, not a reason to drop the check.
      - name: Red-green (new tests must fail against base)
        if: steps.detect.outputs.present == 'true'
        env:
          SCAFFOLD_GATE_STRICT: "1"  # a gate that skips or checks nothing fails
          BASE_SHA: ${{ steps.base.outputs.sha }}
        run: python3 .githooks/lib/check-red-green --base "$BASE_SHA" --ci

      # Diff-scoped mutation testing, advisory-first (issue #145): surviving
      # mutants warn but never fail this step. The script's exit code is
      # captured and sorted three ways:
      #   0  evaluated: unchanged, the step passes.
      #   1  declined: the diff has more mutants than --max-mutants. That is
      #      a size limit, not a finding, so the step passes, writes a job
      #      summary with the local command for the full set, warns, and
      #      sets the output declined=true for the next step.
      #   2  (or anything else) cannot evaluate: the step fails, since the
      #      check evaluated nothing.
      # No continue-on-error here on purpose; the exit codes carry the
      # semantics this workflow wants.
      # This step gets no token on purpose: the script runs mutmut, pytest
      # and the PR's own conftest, all of which inherit the step's env, and
      # a token with `checks: write` there would let a same-repo PR post
      # check runs of any name and conclusion. The token lives only in the
      # next step, which runs none of the PR's code.
      - name: Mutation testing (diff-scoped, advisory)
        id: mutation
        if: steps.detect.outputs.present == 'true'
        env:
          SCAFFOLD_GATE_STRICT: "1"  # a gate that skips or checks nothing fails
          BASE_SHA: ${{ steps.base.outputs.sha }}
        run: |
          pip install mutmut==3.7.0
          rc=0
          python3 .githooks/lib/check-mutation-diff --base "$BASE_SHA" --ci || rc=$?
          if [ "$rc" -eq 0 ]; then
            exit 0
          elif [ "$rc" -ne 1 ]; then
            exit "$rc"
          fi
          {
            echo "### Mutation check declined (size)"
            echo
            echo "The diff has more mutants than the default \`--max-mutants\` limit, so the mutation check did not evaluate it. This is not a finding."
            echo
            echo "Split the PR, or run the full set locally. From the PR branch (\`gh pr checkout <number>\`), in the project's dev environment:"
            echo
            echo '```sh'
            echo "pip install mutmut==3.7.0 && python3 .githooks/lib/check-mutation-diff --base origin/$GITHUB_BASE_REF --max-mutants N"
            echo '```'
            echo
            echo "where N is at least the mutant count printed in this step's log."
          } >> "$GITHUB_STEP_SUMMARY"
          echo "::warning::mutation check declined for size: the diff has more mutants than --max-mutants; split the PR or run the full set locally"
          echo "declined=true" >> "$GITHUB_OUTPUT"
          exit 0

      # TypeScript twin of the two steps above. Node is set up only when a
      # Vitest project was detected.
      - if: steps.detect_ts.outputs.present == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1  # v7.1.0
        with:
          # Stryker 10 and the Vitest majors it supports declare
          # engines.node >= 22; the twins' ES-module fallback needs 20.16+.
          # tests.yml and lint.yml keep their own Node pin.
          node-version: "22"

      - name: Install dependencies (TypeScript)
        if: steps.detect_ts.outputs.present == 'true'
        # Frozen-lockfile install when a lockfile exists, same as tests.yml.
        # --ignore-scripts: vitest is pure JS and never needs a dependency's
        # install hooks, and this runner holds GITHUB_TOKEN.
        run: |
          if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then
            npm ci --ignore-scripts
          else
            npm install --ignore-scripts
          fi

      - name: Red-green TypeScript (new Vitest tests must fail against base)
        if: steps.detect_ts.outputs.present == 'true'
        env:
          SCAFFOLD_GATE_STRICT: "1"  # a gate that skips or checks nothing fails
          BASE_SHA: ${{ steps.base.outputs.sha }}
        run: node .githooks/lib/check-red-green-ts --base "$BASE_SHA" --ci

      # Same exit-code contract and same no-token rule as the Python mutation
      # step: the script runs Stryker and the PR's own vitest config, which
      # inherit this step's env. Stryker is installed here, pinned, without
      # lifecycle scripts, and not saved into the project's package.json.
      # The ad-hoc install is deliberate and suppressed by name: the two top
      # level packages are version-pinned, the consumer's own lockfile cannot
      # cover tools it does not depend on, and --no-save keeps them out of it.
      - name: Mutation testing TypeScript (diff-scoped, advisory)
        id: mutation_ts
        if: steps.detect_ts.outputs.present == 'true'
        env:
          SCAFFOLD_GATE_STRICT: "1"  # a gate that skips or checks nothing fails
          BASE_SHA: ${{ steps.base.outputs.sha }}
        run: | # zizmor: ignore[adhoc-packages]
          npm install --no-save --ignore-scripts --no-audit --no-fund @stryker-mutator/core@10.1.1 @stryker-mutator/vitest-runner@10.1.1
          rc=0
          node .githooks/lib/check-mutation-diff-ts --base "$BASE_SHA" --ci || rc=$?
          if [ "$rc" -eq 0 ]; then
            exit 0
          elif [ "$rc" -ne 1 ]; then
            exit "$rc"
          fi
          {
            echo "### Mutation check declined (size, TypeScript)"
            echo
            echo "The diff has more mutants than the default \`--max-mutants\` limit, so the mutation check did not evaluate it. This is not a finding."
            echo
            echo "Split the PR, or run the full set locally. From the PR branch (\`gh pr checkout <number>\`), in the project's dev environment:"
            echo
            echo '```sh'
            echo "npm install --no-save @stryker-mutator/core@10.1.1 @stryker-mutator/vitest-runner@10.1.1 && node .githooks/lib/check-mutation-diff-ts --base origin/$GITHUB_BASE_REF --max-mutants N"
            echo '```'
            echo
            echo "where N is at least the mutant count printed in this step's log."
          } >> "$GITHUB_STEP_SUMMARY"
          echo "::warning::mutation check declined for size (TypeScript): the diff has more mutants than --max-mutants; split the PR or run the full set locally"
          echo "declined=true" >> "$GITHUB_OUTPUT"
          exit 0

      # Posts the neutral check run for a size decline (either flavour) so it
      # stays visible on the PR without a red X. ONE posting step serves both
      # mutation steps, so `checks: write` and the token exist in exactly one
      # place and that place runs none of the PR's code. Needs `checks: write`;
      # a fork PR's token is read-only, so there it degrades to a warning and
      # the step passes.
      - name: Post neutral check run (mutation declined)
        if: steps.mutation.outputs.declined == 'true' || steps.mutation_ts.outputs.declined == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          DECLINED_PY: ${{ steps.mutation.outputs.declined }}
          DECLINED_TS: ${{ steps.mutation_ts.outputs.declined }}
        run: |
          if [ "$DECLINED_PY" = "true" ]; then
            if ! gh api "repos/${GITHUB_REPOSITORY}/check-runs" \
              -f name='test-guard / mutation (declined: size)' \
              -f head_sha="$HEAD_SHA" \
              -f status=completed \
              -f conclusion=neutral \
              -f 'output[title]=Mutation check declined (size)' \
              -f 'output[summary]=The diff has more mutants than --max-mutants. Split the PR or run the full set locally; see the job summary for the command.' >/dev/null; then
              echo "::warning::could not post the neutral check run (a fork PR's token is read-only); the decline is in the job summary only"
            fi
          fi
          if [ "$DECLINED_TS" = "true" ]; then
            if ! gh api "repos/${GITHUB_REPOSITORY}/check-runs" \
              -f name='test-guard / mutation-ts (declined: size)' \
              -f head_sha="$HEAD_SHA" \
              -f status=completed \
              -f conclusion=neutral \
              -f 'output[title]=Mutation check declined (size, TypeScript)' \
              -f 'output[summary]=The diff has more mutants than --max-mutants. Split the PR or run the full set locally; see the job summary for the command.' >/dev/null; then
              echo "::warning::could not post the neutral check run (a fork PR's token is read-only); the decline is in the job summary only"
            fi
          fi
          exit 0
