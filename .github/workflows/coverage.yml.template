name: coverage

# OPT-IN patch-coverage gate: the strictness layer on top of the default-on
# `tests.yml` (#97). Copy to your project as `.github/workflows/coverage.yml`
# (or `install.sh --coverage-gate`, which installs this INSTEAD OF tests.yml:
# this workflow already runs the tests, so installing both would run them
# twice for the same push/PR).
#
# WHAT THIS DOES — and what it cannot do.
# It fails the PR when lines you ADDED OR CHANGED in this PR are not executed by
# any test (diff-cover, default threshold 100% of changed lines). It deliberately
# does NOT gate on whole-repo coverage %, which lets old untested code mask new
# gaps. The honest ceiling: this forces changed lines to be EXECUTED by a test,
# never VERIFIED by one — an assertion-free test still "covers" a line. Pair it
# with required human review and, for real test-quality signal, mutation testing
# (see RECOMMENDATIONS.md, "forcing tests"). A green check here is necessary, not
# sufficient.
#
# TWO MORE CEILINGS, both of which produce a FALSE GREEN rather than a red, and
# so are the ones worth knowing about:
#   1. It measures PYTHON (pytest-cov) and VITEST, and nothing else. diff-cover
#      scores a changed line it has no coverage data for as COVERED, not as 0%,
#      so in a polyglot repo a brand-new untested .go/.rb/.rs/.java file, or a
#      .ts file under Jest, used to pass at 100% by omission — the more of the
#      repo the gate really covers, the more convincing that false green looks.
#      The "blind spots" step below now FAILS the job on exactly that case.
#   2. It is LINE-based. `branch = True` in .coveragerc feeds the local text
#      report only; diff-cover has no branch option, so a changed one-line
#      `if x: return` whose false arm is never taken scores as covered. The
#      blind-spots step surfaces those as warnings — it does not fail on them.
#
# Runs on pull_request only — patch coverage is defined relative to the PR base.
# Actions are pinned to a commit SHA (trailing comment = version); the SHAs match
# lint.yml so Dependabot bumps them together. Tune DIFF_COVER_FAIL_UNDER below.

on:
  pull_request:

permissions:
  contents: read

env:
  # Percent of changed lines that must be covered. 100 = every line you touched
  # needs a test exercising it. Lower it (e.g. 80) to ease adoption on an
  # existing codebase, then ratchet up.
  DIFF_COVER_FAIL_UNDER: "100"
  # Extensions this repo has DELIBERATELY decided this gate will not measure,
  # space-separated, no dots (e.g. "rb rs"). Everything else that changes in a
  # language with no coverage step here fails the blind-spots step below rather
  # than passing at 100% by omission. Same posture as .scaffold.toml: an
  # exemption is allowed, but it has to be written down where a reviewer sees
  # it. Put the reason in a comment on the line you add.
  COVERAGE_UNMEASURED_OK_EXT: ""

jobs:
  patch-coverage:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          # diff-cover compares against the PR base, so it needs full history.
          fetch-depth: 0
          persist-credentials: false  # don't leave GITHUB_TOKEN in .git/config

      # ── Detect stacks (step output, not job-level if: — see lint.yml) ──────
      - id: detect
        run: |
          if [ -f pyproject.toml ] || [ -f pytest.ini ] || [ -f setup.py ]; then
            echo "python=true" >> "$GITHUB_OUTPUT"
          fi
          # Gate on vitest actually being DECLARED, not merely on package.json
          # existing (#96). A repo can ship package.json for lint tooling only
          # (eslint/prettier/tsc, no test runner) and this step used to run
          # `vitest` there anyway, hard-failing a stack that opted into lint
          # but never into testing.
          if [ -f package.json ] && { grep -q '"vitest"' package.json \
               || grep -qE '"test"[[:space:]]*:[[:space:]]*"[^"]*vitest' package.json; }; then
            echo "frontend=true" >> "$GITHUB_OUTPUT"
          fi

      # ── Python: pytest + coverage → coverage.xml (Cobertura) ──────────────
      - if: steps.detect.outputs.python == 'true'
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version: "3.12"
      - name: Run Python tests with coverage
        if: steps.detect.outputs.python == 'true'
        # Tolerate ONLY pytest's exit 5 (no tests collected), so an empty suite
        # doesn't mask the diff-cover verdict below. Every other non-zero code —
        # 1 failed, 2 interrupted, 3 internal error, 4 usage — fails the job.
        #
        # This used to be a blanket `|| true`, which swallowed exit 1 as well, so
        # a PR with FAILING tests produced a green check (#71). Worse than merely
        # not gating: a failing test still executes the lines it touches and so
        # still writes them into coverage.xml, meaning a PR whose new code is
        # covered only by a red test PASSED the patch-coverage gate on the
        # strength of that very test.
        #
        # `|| rc=$?`, not `; rc=$?`: the default shell for a `run` step is
        # `bash -e`, under which `pytest …; rc=$?` exits at pytest before the
        # assignment is ever reached — which would fail the job on exit 5 and
        # undo the tolerance this block exists to provide. A command on the left
        # of `||` is a tested command and exempt from -e.
        run: |
          # Install the project itself before running its tests (#96). A pytest
          # job that installs only pytest dies at import for any project whose
          # tests import the package under test. Detect a `dev` extra with a
          # grep (same style install.sh uses for its pytest-config detection)
          # rather than a full TOML parse, no extra dependency, and the two
          # states that matter (extra present / absent) are simple string shapes.
          #
          # Only attempt the editable install when the project is actually
          # installable: a `[project]` table (PEP 621) or a `setup.py`. A
          # pyproject.toml that only holds tool config (`[tool.ruff]`,
          # `[tool.pytest.ini_options]`, a poetry package-mode-false project)
          # has no build backend for `pip install -e .` to target, and would
          # hard-fail this step for a project that never claimed to be a package.
          if [ -f pyproject.toml ] && grep -q '^\[project\]' pyproject.toml; then
            if grep -q '^\[project.optional-dependencies\]' pyproject.toml && grep -qE '^dev[[:space:]]*=' pyproject.toml; then
              pip install -e ".[dev]"
            else
              pip install -e .
            fi
          elif [ -f setup.py ]; then
            pip install -e .
          fi
          # Some projects pin test deps in a requirements file instead of (or
          # in addition to) a pyproject extra: install any that exist. `if`/`fi`,
          # not `[ -f "$req" ] && pip install -r "$req"` as the loop body (see
          # tests.yml.template for why that form can exit the STEP non-zero
          # under bash -e when the file is absent, even though nothing failed).
          for req in requirements.txt requirements-dev.txt requirements/dev.txt; do
            if [ -f "$req" ]; then
              pip install -r "$req"
            fi
          done
          # Pinned: an unpinned `pip install` executes whatever version is newest
          # at run time, minutes after publish — contradicting the cooldown posture
          # the scaffold's dependabot.yml.template documents. That file's default
          # config only declares the github-actions ecosystem (see its own
          # comments): these pip version literals are NOT Dependabot-tracked and
          # need a manual bump on upgrades, same as lint.yml's ruff pin, unless
          # you uncomment dependabot.yml's example pip block for your own project.
          pip install pytest==9.1.1 pytest-cov==7.1.0
          rc=0
          pytest --cov --cov-report=xml || rc=$?
          if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
            echo "pytest exited $rc — failing the job (only 5 = no tests collected is tolerated)."
            exit "$rc"
          fi

      # ── Frontend: vitest V8 coverage → coverage/cobertura-coverage.xml ────
      - if: steps.detect.outputs.frontend == 'true'
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020  # v7.0.0
        with:
          node-version: "20"
      - name: Run frontend tests with coverage
        if: steps.detect.outputs.frontend == 'true'
        # --ignore-scripts: same supply-chain hardening as lint.yml. Vitest +
        # @vitest/coverage-v8 are pure JS. Jest projects: swap for your
        # `jest --coverage` command emitting cobertura.
        #
        # No `|| true` here either (#71) — a failing vitest run must fail the job.
        # vitest has no distinct "nothing collected" exit code to special-case
        # the way pytest's 5 is handled above; `--passWithNoTests` is the
        # supported way to say an empty suite is not an error, so it exits 0 and
        # the diff-cover step still gets its say.
        run: |
          if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then
            npm ci --ignore-scripts
          else
            npm install --ignore-scripts
          fi
          npx --no-install vitest run --coverage --passWithNoTests

      # ── Gate: every changed line must be covered ──────────────────────────
      - name: Enforce patch coverage (diff-cover)
        run: |
          pip install diff-cover==10.3.0  # pinned (see note above); NOT Dependabot-tracked, bump by hand
          git fetch --no-tags --depth=1 origin "$GITHUB_BASE_REF"
          REPORTS=""
          [ -f coverage.xml ] && REPORTS="$REPORTS coverage.xml"
          [ -f coverage/cobertura-coverage.xml ] && REPORTS="$REPORTS coverage/cobertura-coverage.xml"
          if [ -z "$REPORTS" ]; then
            echo "No coverage report produced (coverage.xml / cobertura-coverage.xml)."
            echo "Add tests that emit coverage, or this gate cannot run."
            exit 1
          fi
          # Echo the EFFECTIVE threshold into the log. The gate's one continuous
          # off switch is this number, and "100" -> "0" leaves the workflow
          # installed, the job green and the check name unchanged in branch
          # protection. Printing it makes the downgrade visible in the CI log
          # of the very PR that does it (scaffold-doctor.sh reports it too).
          echo "patch-coverage threshold: ${DIFF_COVER_FAIL_UNDER}% of changed lines (scaffold default: 100)"
          # shellcheck disable=SC2086  # REPORTS is a deliberate space-split list
          diff-cover $REPORTS \
            --compare-branch "origin/$GITHUB_BASE_REF" \
            --fail-under "$DIFF_COVER_FAIL_UNDER"

      # ── The gate's blind spots: what diff-cover scores green by omission ───
      # Runs AFTER diff-cover, and only when diff-cover passed. That is on
      # purpose: a red diff-cover already blocks the PR, and the failure mode
      # this step exists for is the GREEN one — diff-cover printing "No lines
      # with coverage information in this diff" and exiting 0.
      #
      # It FAILS (rather than warns) on unmeasured changed source files,
      # matching what this workflow already does one step up when no report at
      # all is produced ("Add tests that emit coverage, or this gate cannot
      # run", exit 1) and what #71 established for the test steps: a coverage
      # gate that cannot tell "measured and covered" from "never looked" is the
      # bug, not a nit. Partially-covered branches are WARNINGS, not failures —
      # diff-cover has no branch mode, so failing on them would enforce a
      # stricter rule than DIFF_COVER_FAIL_UNDER advertises.
      - name: Report the gate's blind spots (unmeasured files, partial branches)
        run: |
          python3 - <<'PY'
          import os, re, subprocess, sys, xml.etree.ElementTree as ET

          base = os.environ["GITHUB_BASE_REF"]
          rng = "origin/%s...HEAD" % base   # same range diff-cover compares

          # Languages this scaffold ships forbidden-pattern denylists for, i.e.
          # the ones it already claims as in scope. Deliberately NOT a guess at
          # "every source extension": a false failure here blocks real PRs.
          CODE = {"py", "ts", "tsx", "js", "jsx", "mjs", "cjs", "mts", "cts",
                  "vue", "svelte", "go", "java", "kt", "kts", "rb", "rs", "php"}
          CODE -= {e.strip().lstrip(".") for e in
                   os.environ.get("COVERAGE_UNMEASURED_OK_EXT", "").split()}

          # Paths no coverage tool is expected to report, so requiring them to
          # be measured would fail every ordinary PR. Tests are excluded from
          # the denominator by .coveragerc's `omit` and vitest's `exclude`;
          # config/type-stub files are excluded by convention.
          SKIP_DIR = ("node_modules/", "dist/", "build/", "vendor/", "coverage/",
                      ".venv/", "venv/", "migrations/", "__tests__/", "tests/",
                      "test/", "spec/", "__mocks__/", "e2e/", "fixtures/")
          SKIP_RE = re.compile(
              r"(^|/)(test_[^/]+\.py|conftest\.py|setup\.py|__init__\.py"
              r"|[^/]+_test\.[^/]+|[^/]+\.(test|spec)\.[^/]+"
              r"|[^/]+\.config\.[^/]+|[^/]+\.d\.ts)$")

          def parts(p):
              return tuple(p.replace("\\", "/").strip("/").split("/"))

          def changed():
              out = subprocess.run(
                  ["git", "diff", "--name-only", "--diff-filter=ACM", rng],
                  capture_output=True, text=True, check=True).stdout
              return [f for f in out.split("\n") if f]

          # Added/changed line numbers per file, from the same unified diff the
          # gate scores. -U0 so only the touched lines land in the ranges.
          def added_lines():
              out = subprocess.run(["git", "diff", "-U0", rng],
                                   capture_output=True, text=True, check=True).stdout
              cur, acc = None, {}
              for line in out.split("\n"):
                  if line.startswith("+++ b/"):
                      cur = line[6:]
                  elif line.startswith("@@") and cur:
                      m = re.search(r"\+(\d+)(?:,(\d+))?", line)
                      if m:
                          start = int(m.group(1))
                          count = int(m.group(2) or 1)
                          acc.setdefault(cur, set()).update(
                              range(start, start + count))
              return acc

          reports = [r for r in ("coverage.xml", "coverage/cobertura-coverage.xml")
                     if os.path.exists(r)]
          measured, partial = [], []
          for rpt in reports:
              for cls in ET.parse(rpt).iter("class"):
                  fn = cls.get("filename")
                  if not fn:
                      continue
                  measured.append(parts(fn))
                  for ln in cls.iter("line"):
                      cc = ln.get("condition-coverage", "")
                      if ln.get("branch") == "true" and cc and not cc.startswith("100%"):
                          partial.append((fn, int(ln.get("number", "0")), cc))

          def is_measured(path):
              # Match on a path SUFFIX in either direction: coverage.py under
              # `source = pkg` emits paths relative to pkg/, vitest emits them
              # relative to the repo root. Erring toward "measured" keeps this
              # step from failing a PR whose file really was in the report.
              cp = parts(path)
              for mp in measured:
                  n = min(len(cp), len(mp))
                  if n and cp[-n:] == mp[-n:]:
                      return True
              return False

          unmeasured = []
          for f in changed():
              ext = f.rsplit(".", 1)[-1] if "." in f else ""
              if ext not in CODE or SKIP_RE.search(f):
                  continue
              # Any dot-prefixed path component is tooling, not measured source:
              # .eslintrc.js, .storybook/main.ts, .github/scripts/*.js. No
              # coverage tool reports these, so requiring them would fail a PR
              # that only touched config.
              if any(c.startswith(".") for c in parts(f)):
                  continue
              # Leading "/" on both sides so "tests/" matches a top-level
              # tests/ as well as a nested one, and never a "mytests/" prefix.
              if any(("/" + d) in ("/" + f) for d in SKIP_DIR):
                  continue
              if not is_measured(f):
                  unmeasured.append(f)

          al = added_lines()   # hoisted: one `git diff -U0`, not one per line

          summary = os.environ.get("GITHUB_STEP_SUMMARY")
          def say(line):
              print(line)
              if summary:
                  with open(summary, "a") as fh:
                      fh.write(line + "\n")

          say("### patch-coverage blind spots")
          say("- reports read: %s" % (", ".join(reports) or "none"))
          say("- changed source files with NO coverage data: %d" % len(unmeasured))
          say("- changed lines with a partially-covered branch: %d" % len(
              [p for p in partial if p[1] in al.get(p[0], ())]))

          for fn, num, cc in partial:
              if num in al.get(fn, ()):
                  print("::warning file=%s,line=%d::partially-covered branch (%s). "
                        "diff-cover is line-based and scores this as COVERED; the "
                        "untaken arm is untested." % (fn, num, cc))

          if unmeasured:
              for f in unmeasured:
                  print("::error file=%s::changed file produced no coverage data at "
                        "all. diff-cover scores it as COVERED by omission, so the "
                        "100%% gate cannot see it." % f)
              say("")
              say("**FAILED**: the files above changed in a language this workflow "
                  "does not measure (it runs pytest-cov and vitest only). Add a "
                  "coverage step emitting Cobertura for that language, widen the "
                  "runner's coverage scope (.coveragerc `source`/`omit`, "
                  "vitest.config.ts `coverage.include`), or list the extension in "
                  "COVERAGE_UNMEASURED_OK_EXT with a reason.")
              sys.exit(1)
          PY
