# Forbidden patterns for PHP files. Applied by .githooks/pre-commit.
# scaffold-extensions: php phtml php3 php4 php5 php7 php8
# Format: <regex><TAB><description>   (one per line; # comments ignored)
# Separator is TAB; patterns can contain literal | for ERE alternation.
# Patterns are case-SENSITIVE, scanned against the staged blob. Copy to
# your project as `.forbidden-patterns/php.txt`.
# error_log() is intentionally NOT banned - it is legitimate logging.
# die()/exit() are common control flow and live in optionalPatterns.

(^|[^A-Za-z_])var_dump[[:space:]]*\(	Remove var_dump() before committing - dumps to stdout
(^|[^A-Za-z_>])dd[[:space:]]*\(	Remove dd() (dump-and-die) before committing - it is a debug call
(^|[^A-Za-z_>])dump[[:space:]]*\(	Remove dump() (var-dumper/Laravel/Symfony) before committing
(^|[^A-Za-z_])xdebug_break[[:space:]]*\(	Remove xdebug_break() before committing

# --- Security: RCE / command-injection / TLS sinks ---
# php -l (the only PHP job the CI template runs) is a syntax check and flags none
# of these, and no other layer of the scaffold sees them. Each sink is matched in
# CALL POSITION only: the name must start the statement, or follow an operator,
# `(`, `,`, `=>`, or return/echo/print/throw/yield. So a METHOD DECLARATION
# (`public function exec(string $sql)`, a `Serializable::unserialize()` impl, an
# `Extractor::extract()`), a member call (`$pdo->exec($sql)`, `Cache::system()`,
# `$zip->extractTo()`), a `$system` variable and docblock prose ("never call
# extract() on request data") all stay quiet. The trade-off: a call preceded by a
# bare word or `?:` (`$x = $ok ?: exec($c)`) is not seen - the common forms are.
# Backticks (`` `$cmd` ``) are NOT covered: a regex cannot tell PHP's shell-exec
# shorthand from a backtick in a comment or a Markdown docblock.
# The hardened call `unserialize($blob, ['allowed_classes' => false])` still
# fires - it is a real call, and the second argument may sit on another line:
# scaffold-allow it once you have checked the argument is there.
(^[[:space:]]*|=>[[:space:]]*|[^A-Za-z0-9_.>:$[:space:]][[:space:]]*|(return|echo|print|throw|yield)[[:space:]]+)unserialize[[:space:]]*\(	unserialize() on untrusted input is PHP object injection (RCE via a POP chain) - use json_decode()
(^[[:space:]]*|=>[[:space:]]*|[^A-Za-z0-9_.>:$[:space:]][[:space:]]*|(return|echo|print|throw|yield)[[:space:]]+)extract[[:space:]]*\(	extract() overwrites arbitrary locals from request data, auth flags included - index the array explicitly
(^[[:space:]]*|=>[[:space:]]*|[^A-Za-z0-9_.>:$[:space:]][[:space:]]*|(return|echo|print|throw|yield)[[:space:]]+)(system|passthru|shell_exec|proc_open|popen|pcntl_exec)[[:space:]]*\(	Shell-execution sink - use a fixed argv and escapeshellarg() every interpolated value
(^[[:space:]]*|=>[[:space:]]*|[^A-Za-z0-9_.>:$[:space:]][[:space:]]*|(return|echo|print|throw|yield)[[:space:]]+)exec[[:space:]]*\(	exec() is a command-injection sink - escapeshellarg() every interpolated value
(^[[:space:]]*|=>[[:space:]]*|[^A-Za-z0-9_.>:$[:space:]][[:space:]]*|(return|echo|print|throw|yield)[[:space:]]+)eval[[:space:]]*\(	eval() executes arbitrary code - there is no safe way to build one from input
CURLOPT_SSL_VERIFY(PEER|HOST)[[:space:]]*(,|=>)[[:space:]]*(false|0)([^0-9]|$)	Disabling cURL TLS verification (MITM risk) - fix the cert/CA bundle instead

# Optional (opt-in) — uncomment a line to enable it:
# (^|[^A-Za-z_])print_r[[:space:]]*\(	print_r() leaks to stdout unless 2nd arg is true - opt in if your app never returns its output
# (^|[^A-Za-z_])var_export[[:space:]]*\(	var_export() leaks to stdout unless 2nd arg is true - opt in if your app never returns its output
# (^|[^A-Za-z_])(die|exit)[[:space:]]*\(	die()/exit() - often legitimate control flow; opt in if your codebase forbids it
# (^|[^A-Za-z_])(TODO|FIXME|XXX)($|[^A-Za-z0-9_])	TODO/FIXME/XXX not allowed - open a ticket instead
# (^|[^A-Za-z_.>:$])assert[[:space:]]*\(	assert(string) evaluates its argument as code on PHP 7 - off by default: assert($x instanceof Foo) is the PHPStan/Psalm type-narrowing idiom (eval() is an active rule above)
